---
import { PREVIEW } from "astro:env/server";

const redirectUrl = `${Astro.site}2026`;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    {PREVIEW && <meta name="robots" content="noindex, nofollow" />}
    <meta name="viewport" content="width=device-width" />
    <meta color-scheme="dark" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>Frontend Conference Tokyo</title>
    <script is:inline define:vars={{ redirectUrl }}>
      window.location.replace(redirectUrl);
    </script>
    <meta http-equiv="refresh" content={`0;url=${redirectUrl}`} />
  </head>
  <body>
    <noscript><a href="/2026/">Frontend Conference Tokyo 2026</a></noscript>
  </body>
</html>
