---
import AboutSection from "@/components/2026/AboutSection.astro";
import Footer from "@/components/2026/Footer.astro";
import Head from "@/components/2026/Head.astro";
import Header from "@/components/2026/Header.astro";
import KeyVisualPartsSection from "@/components/2026/KeyVisualPartsSection.astro";
import MessageSection from "@/components/2026/MessageSection.astro";
import NotesSection from "@/components/2026/NotesSection.astro";
import OpeningAnimation from "@/components/2026/OpeningAnimation.astro";
import OrganizersSection from "@/components/2026/OrganizersSection.astro";
import ProposalsSection from "@/components/2026/ProposalsSection.astro";
import SponsorsSection from "@/components/2026/SponsorsSection.astro";
import TicketsSection from "@/components/2026/TicketsSection.astro";
import TimetableSection from "@/components/2026/TimetableSection.astro";
import "@/css/2026/styles.css";
import "@/css/2026/vars.css";
import Layout from "@/layouts/Layout.astro";
---

<Layout ogTitle="フロントエンドカンファレンス東京 2026" ogImage="ogp/ogp_2026.jpg">
  <Head slot="head" />
  <OpeningAnimation />
  <div class="max-width">
    <Header />
  </div>
  <main>
    <div class="background-shippo page-top">
      {
        /* KV は画面いっぱいに表示するので、.max-width で囲まない */
      }
      <KeyVisualPartsSection />
      {
        /* KV は画面上部に sticky で残し、MessageSection がその上に重なって流れてくる。KV が残るのはこの div の中だけ */
      }
      <MessageSection />
    </div>
    {
      /* About の雲は画面幅いっぱいに並べるので .max-width で囲まない。中身の幅は各セクションで決めている */
    }
    <div class="background-aizome">
      <AboutSection />
      <div class="event-info">
        <TimetableSection />
        <ProposalsSection />
        <TicketsSection />
      </div>
      <SponsorsSection />
      <OrganizersSection />
    </div>
    <div class="background-twilight">
      <NotesSection />
    </div>
  </main>
  <Footer />
</Layout>

<style>
  /*
   * ページ上部の七宝柄の面は、Figma と同じく上から 1024px で赤になり、それより下は赤のまま。
   * 柄の下に敷くグラデーションを --background-shippo-base で渡す（.background-shippo は styles.css）。
   */
  .page-top {
    --background-shippo-base: linear-gradient(
      180deg,
      var(--color-peach) 0,
      var(--color-coral) calc(1024px * 0.0865),
      var(--color-red) 1024px
    );
  }

  /*
   * タイムテーブル・プロポーザル・チケットの3セクション。
   * 同じ幅・同じ高さで並べる。
   */
  .event-info {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    max-width: var(--width-desktop);
    padding: 40px 120px;
    margin-inline: auto;
  }

  /* タブレット: 余白を上下左右 40px にする */
  @media (width <= 1080px) {
    .event-info {
      padding: 40px;
    }
  }

  /*
   * 3枚のカードは折り返さずに横に並べる（狭いときはカードの中身を縮めて収める。LinkCard.astro）。
   * モバイルだけは横に並べると読めない大きさになるので、縦に積む
   */
  @media (width <= 720px) {
    .event-info {
      grid-template-columns: minmax(0, 1fr);
      padding-inline: 20px;
    }
  }

  /*
   * foundation.css の main は overflow-x: hidden で、main 自体がスクロールの枠になり KV の sticky が効かない。
   * clip ならスクロールの枠にならずに横のはみ出しだけ切れるので、2026 ではこちらにする
   */
  main {
    overflow: clip visible;
  }

  .max-width {
    max-width: var(--width-desktop);
    margin-inline: auto;
  }
</style>
