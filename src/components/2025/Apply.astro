---
import { Image } from "astro:assets";
import ApplyImage from "@/assets/2025/apply-button.png";
---

<a
  href="https://fec-tokyo.connpass.com/event/352581/"
  target="_blank"
  class="apply"
>
  <Image src={ApplyImage} width={200} height={200} alt="応募する" />
</a>
<style>
  @import "../../css/utils.css";
  @import "../../css/2025/vars.css";

  .apply {
    position: fixed;
    right: 40px;
    bottom: 40px;
    z-index: var(--apply-button-z-index);
    display: inline-block;
    border-radius: 50%;
    transition: opacity 0.15s;
  }

  @media (--breakpoint-sp) {
    .apply {
      display: none;
    }
  }
  @media (hover: hover) {
    .apply:hover {
      opacity: 0.6;
    }
  }
</style>
