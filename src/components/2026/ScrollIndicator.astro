---
import ScrollDownText from "@/assets/2026/text-scroll-down.svg";
---

{/* 操作できない飾りなので、支援技術には読ませない */}
<div class="scrollIndicator" aria-hidden="true">
  <span class="mouse">
    <span class="wheel"></span>
  </span>
  <img src={ScrollDownText.src} alt="" width="100" height="9" />
</div>

<style scoped>
  /*
   * 寸法はすべて --u の倍数で書く。--u は既定で 1px で、使う側から --scroll-indicator-unit で長さを渡すと、
   * 画面の大きさに合わせて伸び縮みさせられる（KeyVisualPartsSection）。そのときはタブレット以下の縮小（zoom）も
   * --scroll-indicator-zoom: 1 で止める。
   */
  .scrollIndicator {
    --u: var(--scroll-indicator-unit, 1px);

    display: flex;
    flex-direction: column;
    gap: calc(6 * var(--u));
    align-items: center;
  }

  .mouse {
    display: flex;
    justify-content: center;
    width: calc(28 * var(--u));
    height: calc(48 * var(--u));
    padding-top: calc(10 * var(--u));

    /* 小さくしても線が消えないよう、1px より細くはしない */
    border: max(1px, 2 * var(--u)) solid var(--color-white);
    border-radius: calc(16 * var(--u));
  }

  .wheel {
    width: calc(8 * var(--u));
    height: calc(8 * var(--u));
    background-color: var(--color-white);
    border-radius: calc(10 * var(--u));
    animation: scroll-wheel 1.6s ease-in-out infinite;
  }

  .scrollIndicator img {
    display: block;
    width: calc(100 * var(--u));
    height: calc(9 * var(--u));
  }

  /* ホイールの点が下に流れて消え、元の位置に戻る */
  @keyframes scroll-wheel {
    0% {
      opacity: 0;
      transform: translateY(0);
    }

    20% {
      opacity: 1;
    }

    70% {
      opacity: 1;
    }

    100% {
      opacity: 0;
      transform: translateY(calc(14 * var(--u)));
    }
  }

  /* タブレットとモバイルのデザインでは、マウスの幅が 28px → 25px になるよう全体を縮めている */
  @media (width <= 1080px) {
    .scrollIndicator {
      zoom: var(--scroll-indicator-zoom, calc(25 / 28));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wheel {
      animation: none;
    }
  }
</style>
