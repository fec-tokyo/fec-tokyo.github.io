---
/*
 * KV の下に重なって流れてくるメッセージのセクション。
 * 上端に雲を並べ、その下のクリーム色の青海波の面に、見出し・メッセージ・開催概要の表を中央ぞろえで縦に並べる。
 */
import CloudImage from "@/assets/2026/sections/message/cloud.svg";
import DividerImage from "@/assets/2026/sections/message/divider.svg";
import TitleLineImage from "@/assets/2026/sections/message/title-line.svg";
import SeigaihaImage from "@/assets/2026/seigaiha.svg";

// Figma の行の区切りどおりに段落ごと・行ごとに持つ
const paragraphs = [
  [
    "誰でもコードを書ける時代になった｡",
    "フロントエンドは、誰にとっても身近になった｡",
  ],
  [
    "わたしたちは何のためにコードを書くのか？",
    "フロントエンドの未来は、AIが担うのか？",
  ],
  [
    "技術も文化も、人から人へと受け継がれてきた｡",
    "第一線の知見・工夫・問い――",
    "持ち寄り、語り合い、次の世代へ紡いでいく｡",
  ],
  ["AIがつくった未来を生きるのではなく", "AIと共に、未来をつくっていく｡"],
  ["さあ、いまこそ", "“フロントエンドの未来の話をしよう”"],
];

// OverviewSection.astro の表と同じ内容
const items = [
  { label: "開催日時", value: "2026年12月05日（土）10:00~18:00" },
  { label: "会場", value: "住友不動産渋谷タワー Abema Towers" },
  {
    label: "対象",
    value: "フロントエンドやWeb技術に携わる全てのエンジニア・デザイナー",
  },
  {
    label: "主催",
    value: "フロントエンドカンファレンス東京実行委員会（主宰：平井 柊太）",
  },
];
---

<section
  id="message"
  class="container"
  aria-labelledby="message-title"
  style={`--cloud-image: url(${CloudImage.src}); --divider-image: url(${DividerImage.src}); --seigaiha-image: url(${SeigaihaImage.src})`}
>
  {/* セクションの上端に並べる雲。画面幅いっぱいに横に繰り返す */}
  <div class="cloud" aria-hidden="true"></div>
  <div class="body" data-message-body>
    {
      /* 文字がはけた後に、スクロールに合わせて About の藍色に変えていくための面 */
    }
    <div class="dissolve" aria-hidden="true"></div>
    {
      /* 文字部分は画面の上下中央に固定し（JS が動くとき）、hold の分スクロールする間そのまま見せる */
    }
    <div class="pin">
      <div class="content" data-message-content>
        <hgroup class="heading" data-reveal>
          <h2 id="message-title" class="title">
            WHY NOW?
            <img
              src={TitleLineImage.src}
              alt=""
              width={TitleLineImage.width}
              height={TitleLineImage.height}
              class="titleLine"
            />
          </h2>
          <p class="subtitle">なぜ、いま、フロカン？</p>
        </hgroup>
        <div class="message">
          {
            paragraphs.map((lines) => (
              <p class="paragraph" data-reveal>
                {lines.map((line) => (
                  <span class="line">{line}</span>
                ))}
              </p>
            ))
          }
        </div>
        <dl class="list" data-reveal>
          {
            items.map((item) => (
              <div class="item">
                <dt class="label">{item.label}</dt>
                <dd class="value">{item.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
      <div class="hold" aria-hidden="true"></div>
    </div>
  </div>
</section>

<script>
  /*
   * 文字部分（data-message-content）は、画面の上下中央に固定する。画面より高いときは、下端をそろえて全体が見える位置で固定する。
   * 面の上端は文字部分の上に同じだけあけておき、面の上端が画面の上端に届いたちょうどそのときに固定が始まるようにしている。
   *
   * 見出し・段落・表（data-reveal）は、KV が見えている間は出さず、面の上端が画面の上端に届いたら、
   * そのとき画面に入っているものを上から順に少しずつ遅らせてフェードインさせる。それより下にあったものは画面に入ったら出す。
   * 画面より上に過ぎた要素も出したことにする（アンカーリンクなどで飛ばしたときや、途中から開いたときのため）。
   *
   * セクションの下端が画面の下端に届くまでの画面 FADE_SCREENS 枚分のスクロールで（固定の終わり際から）、
   * 面を About の藍色にディゾルブさせ（--dissolve: 0 → 1）、同時に文字部分を透明にする。
   * セクションの下端が画面に入る時点では、どちらも変わり切っていて、すぐ下に About の中身が続く。
   */
  const FADE_SCREENS = 0.4;

  document
    .querySelectorAll<HTMLElement>("[data-message-body]")
    .forEach((body) => {
      const targets = [...body.querySelectorAll<HTMLElement>("[data-reveal]")];
      const seen = new Set<HTMLElement>();
      let ready = false;

      const content = body.querySelector<HTMLElement>("[data-message-content]");

      const reveal = (elements: HTMLElement[]) => {
        elements
          .sort((a, b) => targets.indexOf(a) - targets.indexOf(b))
          .forEach((el, i) => {
            el.style.setProperty("--reveal-index", String(i));
            el.dataset.revealed = "true";
          });
      };

      // 文字部分の高さから、固定する位置（--content-top）と面の上端からの余白（--content-offset）を決める
      const measure = () => {
        if (!content) return;
        const space = innerHeight - content.offsetHeight;
        body.style.setProperty(
          "--content-top",
          `${space >= 0 ? space / 2 : space}px`,
        );
        body.style.setProperty(
          "--content-offset",
          `${Math.max(0, space / 2)}px`,
        );
      };

      // 見えた（または過ぎた）要素を覚え、面が画面を覆った後なら出す
      const markSeen = (elements: HTMLElement[]) => {
        const fresh = elements.filter((el) => !seen.has(el));
        fresh.forEach((el) => seen.add(el));
        if (ready) reveal(fresh);
      };

      const observer = new IntersectionObserver(
        (entries) => {
          markSeen(
            entries
              .filter((entry) => entry.isIntersecting)
              .map((entry) => entry.target as HTMLElement),
          );
        },
        { threshold: 0.2 },
      );
      targets.forEach((el) => observer.observe(el));

      let ticking = false;
      const update = () => {
        ticking = false;
        markSeen(targets.filter((el) => el.getBoundingClientRect().bottom < 0));
        if (!ready && body.getBoundingClientRect().top <= 0) {
          ready = true;
          reveal([...seen]);
        }
        // セクションの下端が、画面の下端より FADE_SCREENS 枚分下にあるときに 0、画面の下端に届いたときに 1
        const progress = Math.min(
          1,
          Math.max(
            0,
            1 -
              (body.getBoundingClientRect().bottom - innerHeight) /
                (innerHeight * FADE_SCREENS),
          ),
        );
        body.style.setProperty("--dissolve", String(progress));
        if (content) content.style.opacity = String(1 - progress);
      };
      const requestUpdate = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      };
      measure();
      update();
      addEventListener("scroll", requestUpdate, { passive: true });
      addEventListener("resize", () => {
        measure();
        requestUpdate();
      });
      document.fonts.ready.then(() => {
        measure();
        requestUpdate();
      });
    });
</script>

<style scoped>
  /*
   * Figma のとおり、高さ 50px の雲の下にセクションの面を続ける。
   * KV の上に重なって流れてくるので、雲のすき間からは KV が透けて見える。
   */
  .container {
    --color-message-base: #f6eedd;

    position: relative;
  }

  /*
   * Figma の塗りは「#F6EEDD + 白い青海波のタイル（68×40）を不透明度 40%・オーバーレイで重ねたもの」。
   * 白は地より明るいので、オーバーレイは普通の重ね方と同じ結果になる。
   * 背景画像には不透明度を付けられないので、白い柄の上に 60% の地の色を重ね、柄が 40% だけ透けるようにしている。
   */
  .body {
    position: relative;

    /*
     * 上は、文字部分を画面の上下中央に置いたときの上の余白（JS で決める。JS が動かないときは 120px）。
     * 下は、文字の固定が外れてからセクションが終わるまでの少しの余白（画面の高さの 10%）
     */
    padding: var(--content-offset, 120px) 20px 10svh;
    color: var(--color-black);
    background-color: var(--color-message-base);
    background-image:
      linear-gradient(
        color-mix(in srgb, var(--color-message-base) 60%, transparent),
        color-mix(in srgb, var(--color-message-base) 60%, transparent)
      ),
      var(--seigaiha-image);
    background-position: top center;
  }

  /*
   * 雲。SVG は1つ分の部品（幅 240px・高さ 50px）で、それをマスクにして横に繰り返し、雲の形に切り抜く。
   * 塗りは Figma と同じく、上端から 10px までは白・下端で地の色になるグラデーションに、白い青海波を 40% で重ねる。
   * 面と同じく、柄の上にグラデーションを 60% で重ねて柄を 40% だけ透かし、いちばん下に同じグラデーションを敷いている。
   * 青海波は面の柄と継ぎ目なくつながるよう、面の上端（雲の上から 50px）を起点にしている。
   */
  .cloud {
    --cloud-gradient-opacity: 60%;

    height: 50px;
    pointer-events: none;
    background-image:
      linear-gradient(
        color-mix(
            in srgb,
            var(--color-white) var(--cloud-gradient-opacity),
            transparent
          )
          10px,
        color-mix(
          in srgb,
          var(--color-message-base) var(--cloud-gradient-opacity),
          transparent
        )
      ),
      var(--seigaiha-image),
      linear-gradient(var(--color-white) 10px, var(--color-message-base));
    background-position:
      0 0,
      center 50px,
      0 0;
    mask-image: var(--cloud-image);
    mask-repeat: repeat-x;
    mask-position: top center;
    mask-size: 240px 50px;
  }

  /* ディゾルブ先の面。About と同じ藍色 + ノイズ（.background-aizome と同じ）を、--dissolve の不透明度で重ねる */
  .dissolve {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-color: var(--color-aizome);
    background-image: var(--texture-noise-subtle);
    opacity: var(--dissolve, 0);
  }

  /* 文字部分はディゾルブの面より手前に置く */
  .pin {
    position: relative;
    width: 100%;
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: 64px;
    align-items: center;
  }

  /* 固定は JS が位置を決めるときだけ。hold の高さ分スクロールする間、文字部分を固定したまま見せる */
  @media (scripting: enabled) {
    .content {
      position: sticky;
      top: var(--content-top, 0);
    }

    .hold {
      height: 100svh;
    }
  }

  /* 文字は下から少し浮き上がりながらフェードインさせる。JS が動かない環境では最初から表示しておく */
  [data-reveal] {
    transition:
      opacity var(--duration-inview) var(--easing-out),
      translate var(--duration-inview) var(--easing-out);
    transition-delay: calc(var(--reveal-index, 0) * 120ms);
  }

  @media (scripting: enabled) {
    [data-reveal]:not([data-revealed]) {
      opacity: 0;
      translate: 0 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal] {
      transition: none;
    }
  }

  .heading {
    display: flex;
    flex-direction: column;
    gap: 6px;
    align-items: center;
    margin: 0;
  }

  /* 下線（Figma の Line）は見出しの幅いっぱいに伸ばし、文字との間は 2px あける */
  .title {
    display: flex;
    flex-direction: column;
    gap: 2px;
    align-items: stretch;
    margin: 0;
    font-family: Montserrat, sans-serif;
    font-size: 32px;
    font-weight: 900;
    line-height: 1;
    text-align: center;
    letter-spacing: 0.04em;
  }

  .titleLine {
    display: block;
    width: 100%;
    height: 2px;
  }

  .subtitle {
    margin: 0;
    font-family: "Noto Sans JP", sans-serif;
    font-size: 16px;
    font-weight: 900;
    line-height: 1;
    letter-spacing: 0.04em;
  }

  .message {
    display: flex;
    flex-direction: column;
    gap: 40px;
    align-items: center;
    font-family: "Noto Sans JP", sans-serif;
    font-size: 20px;
    font-weight: 700;
    line-height: 1;
    text-align: center;
    letter-spacing: 0.04em;
  }

  .paragraph {
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: center;
    margin: 0;
  }

  .line {
    display: block;
    white-space: nowrap;
  }

  .list {
    display: flex;
    flex-direction: column;

    /* 項目の間 25px（点線の上下に 12px ずつ） */
    gap: 25px;
    width: 100%;
    max-width: 640px;
    padding: 20px 24px;
    margin: 0;
    font-family: "Noto Sans JP", sans-serif;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: 0.04em;
    background-color: var(--color-white);
    border: 1px solid var(--color-black);
    border-radius: 16px;
  }

  .item {
    display: flex;
    align-items: center;
  }

  /*
   * 項目の間の点線（Figma の Line）。上の項目との間 25px の真ん中に置く。
   * SVG は幅 590px で、それより広いときは横に繰り返す。
   */
  .item + .item {
    position: relative;
  }

  .item + .item::before {
    position: absolute;
    top: -13px;
    left: 0;
    width: 100%;
    height: 1px;
    content: "";
    background-image: var(--divider-image);
    background-repeat: repeat-x;
  }

  .label {
    flex-shrink: 0;
    width: 120px;
  }

  .value {
    flex: 1 0 0;
    min-width: 0;
    margin: 0;

    /* foundation.css の text-autospace: normal だと「Web」の前後に隙間が入るので、Figma に合わせて切る */
    text-autospace: no-autospace;
  }

  /*
   * モバイル: デザインはまだないので、メッセージは Figma の行のまま折り返さず、
   * いちばん長い行（21文字 + 字間）が幅に収まるよう、画面幅に合わせて文字を小さくする（最大 16px）
   */
  @media (width <= 720px) {
    .content {
      gap: 48px;
    }

    .message {
      gap: 32px;
      font-size: min(16px, (100vw - 40px) / 22.5);
    }

    .list {
      padding: 16px 20px;
    }

    .item {
      gap: 16px;
    }

    .label {
      width: 60px;
    }
  }
</style>
