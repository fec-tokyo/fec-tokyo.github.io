---
/*
 * KV の下に重なって流れてくるメッセージのセクション。
 * 上端に雲を並べ、その下のクリーム色の青海波の面に、見出し・メッセージ・開催概要を中央ぞろえで縦に並べる。
 */
import CloudImage from "@/assets/2026/sections/message/cloud.svg";
import TitleLineImage from "@/assets/2026/sections/message/title-line.svg";
import SeigaihaImage from "@/assets/2026/seigaiha.svg";
import { VENUE_MAP_URL } from "@/data/2026/links";

// Figma の行の区切りどおりに段落ごと・行ごとに持つ
const paragraphs = [
  [
    "誰でもコードを書ける時代になった｡",
    "フロントエンドは、誰にとっても身近になった｡",
  ],
  [
    "わたしたちは何のためにコードを書くのか？",
    "フロントエンドの未来は、AIが担うのか？",
  ],
  [
    "技術も文化も、人から人へと受け継がれてきた｡",
    "第一線の知見・工夫・問い――",
    "持ち寄り、語り合い、次の世代へ紡いでいく｡",
  ],
  // PC では1行につなげて表示する（.paragraph.joined）
  ["AIがつくった未来を生きるのではなく､", "AIと共に未来をつくっていく｡"],
  ["さあ、いまこそ", "“フロントエンドの未来の話をしよう”"],
];

// PC で1行につなげる段落の位置
const JOINED_PARAGRAPH_INDEX = 3;

// メッセージの下に置く開催概要。value は HTML として出す。
// 開催場所は地図へのリンクを文中に入れる。テンプレートに書くと改行が「は」と「こちら」の間の空白になるので、文字列で持つ
const overviewItems = [
  { label: "開催日時", value: "2026年12月05日（土）10:00~18:00" },
  {
    label: "開催場所",
    value: `住友不動産渋谷タワー Abema Towers（アクセスは<a href="${VENUE_MAP_URL}" target="_blank" rel="noopener noreferrer">こちら</a>）`,
  },
  {
    label: "対象",
    value: "フロントエンドやWeb技術に携わる全てのエンジニア・デザイナー",
  },
  { label: "主催", value: "フロントエンドカンファレンス東京実行委員会" },
  {
    label: "後援・協力",
    value: "一般社団法人フロントエンドカンファレンスアソシエーション",
  },
];
---

<section
  id="message"
  class="container"
  aria-labelledby="message-title"
  style={`--cloud-image: url(${CloudImage.src}); --seigaiha-image: url(${SeigaihaImage.src})`}
>
  {/* セクションの上端に並べる雲。画面幅いっぱいに横に繰り返す */}
  <div class="cloud" aria-hidden="true"></div>
  <div class="body" data-message-body>
    {
      /* 文字がはけた後に、スクロールに合わせて About の藍色に変えていくための面 */
    }
    <div class="dissolve" aria-hidden="true"></div>
    {
      /* ディゾルブの途中で About が入ってきても境目が出ないよう、面の下端を About の藍色に溶かしておく帯 */
    }
    <div class="dissolveEdge" aria-hidden="true"></div>
    {
      /* 文字部分は画面の上下中央に固定し（JS が動くとき）、hold の分スクロールする間そのまま見せる */
    }
    <div class="pin">
      <div class="content" data-message-content>
        <hgroup class="heading" data-reveal>
          <h2 id="message-title" class="title">
            <span class="titleText">
              <span class="titleTextInner">WHY NOW?</span>
            </span>
            <img
              src={TitleLineImage.src}
              alt=""
              width={TitleLineImage.width}
              height={TitleLineImage.height}
              class="titleLine"
            />
          </h2>
          <p class="subtitle">なぜ、いま、フロカン？</p>
        </hgroup>
        <div class="message">
          {
            paragraphs.map((lines, index) => (
              <p
                class:list={[
                  "paragraph",
                  { joined: index === JOINED_PARAGRAPH_INDEX },
                ]}
                data-reveal
              >
                {lines.map((line) => (
                  <span class="line">{line}</span>
                ))}
              </p>
            ))
          }
        </div>
        <dl class="overview" data-reveal>
          {
            overviewItems.map(({ label, value }) => (
              <div class="overviewItem">
                <dt>{label}</dt>
                <dd set:html={value} />
              </div>
            ))
          }
        </dl>
      </div>
      <div class="hold" aria-hidden="true"></div>
    </div>
  </div>
</section>

<script>
  /*
   * 文字部分（data-message-content）は、画面の上下中央に固定する。画面より高いときは、下端をそろえて全体が見える位置で固定する。
   * 面の上端は文字部分の上に同じだけあけておき、面の上端が画面の上端に届いたちょうどそのときに固定が始まるようにしている。
   *
   * 見出し・段落（data-reveal）は、KV が見えている間は出さず、面の上端が画面の上端に届いたら、
   * そのとき画面に入っているものを上から順に出す。段落は見出しが出終わる 100ms 前（REVEAL_LAG）から、
   * 1つ1つの出終わりを待たずに PARAGRAPH_STAGGER ずつずらして続けて出す。
   * それより下にあったものは画面に入ったら、前の段落が出始めてから PARAGRAPH_STAGGER たつまで待ってから同じように出す。
   * 画面より上に過ぎた要素も出したことにする（アンカーリンクなどで飛ばしたときや、途中から開いたときのため）。
   *
   * セクションの下端が、画面の下端から画面 FADE_END_SCREENS 枚分上に届くまでの画面 FADE_SCREENS 枚分のスクロールで（固定の終わり際から）、
   * 面を About の藍色にディゾルブさせ（--dissolve: 0 → 1）、同時に文字部分を透明にする。
   * 変わり切るのを待たずに、ディゾルブの途中から下の About が画面に入ってくる。
   */
  const FADE_SCREENS = 0.6;

  // ディゾルブが終わる位置。セクションの下端が、画面の下端からこの枚数分上に来たときに変わり切る
  const FADE_END_SCREENS = 0.4;

  // 前の要素が出終わってから次の要素を出し始めるまでの間（ms）。マイナスなので、前の要素が出終わる前に重ねて出し始める
  const REVEAL_LAG = -100;

  // 段落を続けて出すときの、前の段落が出始めてから次の段落を出し始めるまでの間（ms）
  const PARAGRAPH_STAGGER = 200;

  // 見出しのアニメーションの長さ（ms）。CSS の .heading の中身の transition（英字は 300ms 後から 500ms、最後の日本語は 700ms 後から出始める）に合わせる。
  // 日本語は本文と同じくゆっくりフェードインさせるので、出終わりを待たず、出始めから 400ms たったところを見出しの出終わりとみなす
  const HEADING_DURATION = 1100;

  document
    .querySelectorAll<HTMLElement>("[data-message-body]")
    .forEach((body) => {
      const targets = [...body.querySelectorAll<HTMLElement>("[data-reveal]")];
      const seen = new Set<HTMLElement>();
      let ready = false;

      const content = body.querySelector<HTMLElement>("[data-message-content]");

      // 次の要素を出し始めてよい時刻（performance.now() 基準）
      let nextStart = -Infinity;

      const reveal = (elements: HTMLElement[]) => {
        const now = performance.now();
        elements
          .sort((a, b) => targets.indexOf(a) - targets.indexOf(b))
          .forEach((el) => {
            const start = Math.max(now, nextStart);
            el.style.setProperty("--reveal-delay", `${start - now}ms`);
            el.dataset.revealed = "true";
            nextStart = el.matches(".heading")
              ? start + HEADING_DURATION + REVEAL_LAG
              : start + PARAGRAPH_STAGGER;
          });
      };

      // 文字部分の高さを CSS に渡す。固定する位置と面の上端からの余白は、CSS でこれと 100svh から決める。
      // アドレスバーの出入りでは文字部分の高さは変わらないので、そのときは書き換えない
      if (content) {
        new ResizeObserver(() => {
          body.style.setProperty(
            "--content-height",
            `${content.offsetHeight}px`,
          );
        }).observe(content);
      }

      // 見えた（または過ぎた）要素を覚え、面が画面を覆った後なら出す
      const markSeen = (elements: HTMLElement[]) => {
        const fresh = elements.filter((el) => !seen.has(el));
        fresh.forEach((el) => seen.add(el));
        if (ready) reveal(fresh);
      };

      const observer = new IntersectionObserver(
        (entries) => {
          markSeen(
            entries
              .filter((entry) => entry.isIntersecting)
              .map((entry) => entry.target as HTMLElement),
          );
        },
        { threshold: 0.2 },
      );
      targets.forEach((el) => observer.observe(el));

      let ticking = false;
      const update = () => {
        ticking = false;
        markSeen(targets.filter((el) => el.getBoundingClientRect().bottom < 0));
        if (!ready && body.getBoundingClientRect().top <= 0) {
          ready = true;
          reveal([...seen]);
        }
        // セクションの下端が、ディゾルブが終わる位置より FADE_SCREENS 枚分下にあるときに 0、その位置に届いたときに 1
        const progress = Math.min(
          1,
          Math.max(
            0,
            1 -
              (body.getBoundingClientRect().bottom -
                innerHeight * (1 - FADE_END_SCREENS)) /
                (innerHeight * FADE_SCREENS),
          ),
        );
        body.style.setProperty("--dissolve", String(progress));
        if (content) content.style.opacity = String(1 - progress);
      };
      const requestUpdate = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      };
      update();
      addEventListener("scroll", requestUpdate, { passive: true });
      addEventListener("resize", requestUpdate);
    });
</script>

<style scoped>
  /*
   * Figma のとおり、高さ 50px の雲の下にセクションの面を続ける。
   * KV の上に重なって流れてくるので、雲のすき間からは KV が透けて見える。
   * 雲の高さの分だけ KV（高さ 100svh）に重ね、ページを開いたときに画面の下端に雲だけが見えるようにする。
   */
  .container {
    --color-message-base: #f6eedd;
    --cloud-height: 50px;

    position: relative;
    margin-top: calc(var(--cloud-height) * -1);
  }

  /* 縦長の画面（縦横比 9:16 以下）では、KV に対して雲が大きく見えるので高さ 20px にする */
  @media (aspect-ratio <= 9 / 16) {
    .container {
      --cloud-height: 20px;
    }
  }

  /*
   * Figma の塗りは「#F6EEDD + 白い青海波のタイル（68×40）を不透明度 40%・オーバーレイで重ねたもの」。
   * 白は地より明るいので、オーバーレイは普通の重ね方と同じ結果になる。
   * 背景画像には不透明度を付けられないので、白い柄の上に 60% の地の色を重ね、柄が 40% だけ透けるようにしている。
   */
  .body {
    /*
     * 文字部分を固定する位置（--content-top）と面の上端からの余白（--content-offset）。
     * アドレスバーの出入りで動かないよう、画面の高さは 100svh を使い、1px のブレが出ないよう整数 px に切り捨てる。
     * 画面より高いときは、下端をそろえる位置で固定し、余白は 0 にする。
     * --content-height は JS で決めるので、JS が動かないときはどちらも無効になり、下の代わりの値を使う
     */
    --content-space: calc(100svh - var(--content-height));
    --content-top: min(
      round(down, var(--content-space) / 2, 1px),
      var(--content-space)
    );
    --content-offset: max(0px, round(down, var(--content-space) / 2, 1px));

    position: relative;

    /*
     * 上は、文字部分を画面の上下中央に置いたときの上の余白（JS が動かないときは 120px）。
     * 下は、文字の固定が外れてからセクションが終わるまでの少しの余白（画面の高さの 10%）
     */
    padding: var(--content-offset, 120px) 20px 10svh;
    color: var(--color-black);
    background-color: var(--color-message-base);
    background-image:
      linear-gradient(
        color-mix(in srgb, var(--color-message-base) 60%, transparent),
        color-mix(in srgb, var(--color-message-base) 60%, transparent)
      ),
      var(--seigaiha-image);
    background-position: top center;
  }

  /*
   * 雲。SVG は1つ分の部品（幅 240px・高さ 50px）で、それをマスクにして横に繰り返し、雲の形に切り抜く。
   * 雲の高さを変えても形が変わらないよう、部品の幅と白の範囲は高さに比例させる（高さ 50px のとき幅 240px・白 10px）。
   * 塗りは Figma と同じく、上端から 10px までは白・下端で地の色になるグラデーションに、白い青海波を 40% で重ねる。
   * 面と同じく、柄の上にグラデーションを 60% で重ねて柄を 40% だけ透かし、いちばん下に同じグラデーションを敷いている。
   * 青海波は面の柄と継ぎ目なくつながるよう、面の上端（雲の下端）を起点にしている。
   */
  .cloud {
    --cloud-gradient-opacity: 60%;
    --cloud-white-height: calc(var(--cloud-height) / 5);

    height: var(--cloud-height);
    pointer-events: none;
    background-image:
      linear-gradient(
        color-mix(
            in srgb,
            var(--color-white) var(--cloud-gradient-opacity),
            transparent
          )
          var(--cloud-white-height),
        color-mix(
          in srgb,
          var(--color-message-base) var(--cloud-gradient-opacity),
          transparent
        )
      ),
      var(--seigaiha-image),
      linear-gradient(
        var(--color-white) var(--cloud-white-height),
        var(--color-message-base)
      );
    background-position:
      0 0,
      center var(--cloud-height),
      0 0;
    mask-image: var(--cloud-image);
    mask-repeat: repeat-x;
    mask-position: top center;
    mask-size: calc(var(--cloud-height) * 4.8) var(--cloud-height);
  }

  /* ディゾルブ先の面。About と同じ藍色 + ノイズ（.background-aizome と同じ）を、--dissolve の不透明度で重ねる */
  .dissolve {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-color: var(--color-aizome);
    background-image: var(--texture-noise-subtle);
    opacity: var(--dissolve, 0);
  }

  /*
   * 面の下端の帯。--dissolve に関係なく、上は透明・下端は About と同じ藍色 + ノイズになるグラデーションで常に重ねておく。
   * セクションの下端が画面に入るのはディゾルブの途中からなので、帯の濃いところがディゾルブ前のクリーム色の面に見えることはない
   */
  .dissolveEdge {
    position: absolute;
    inset: auto 0 0;
    height: 40svh;
    pointer-events: none;
    background-color: var(--color-aizome);
    background-image: var(--texture-noise-subtle);
    mask-image: linear-gradient(transparent, black);
  }

  /* 文字部分はディゾルブの面より手前に置く */
  .pin {
    position: relative;
    width: 100%;
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: 64px;
    align-items: center;
  }

  /* 固定は JS が位置を決めるときだけ。hold の高さ分スクロールする間、文字部分を固定したまま見せる */
  @media (scripting: enabled) {
    .content {
      position: sticky;
      top: var(--content-top, 0);
    }

    .hold {
      height: 300svh;
    }
  }

  /* 文字は下から少し浮き上がりながらフェードインさせる。JS が動かない環境では最初から表示しておく */
  [data-reveal] {
    transition:
      opacity var(--duration-inview) var(--easing-out),
      translate var(--duration-inview) var(--easing-out);
    transition-delay: var(--reveal-delay, 0ms);
  }

  @media (scripting: enabled) {
    [data-reveal]:not([data-revealed]) {
      opacity: 0;
      translate: 0 24px;
    }
  }

  /*
   * 見出しは全体を動かさず、中身を順に出す。
   * 1. 下線が中央から左右へ伸びる  2. 英字が下線の下からせり上がる  3. 日本語がフェードインする
   * それぞれ、前のものが出終わる 100ms 前から次を始める
   */
  .heading {
    --heading-delay: var(--reveal-delay, 0ms);
  }

  .titleLine {
    transition: scale 400ms var(--easing-out) var(--heading-delay);
  }

  .titleTextInner {
    transition: translate 500ms var(--easing-out)
      calc(var(--heading-delay) + 300ms);
  }

  .subtitle {
    transition: opacity var(--duration-inview) var(--easing-out)
      calc(var(--heading-delay) + 700ms);
  }

  @media (scripting: enabled) {
    .heading[data-reveal]:not([data-revealed]) {
      opacity: 1;
      translate: none;
    }

    .heading:not([data-revealed]) .titleLine {
      scale: 0 1;
    }

    .heading:not([data-revealed]) .titleTextInner {
      translate: 0 100%;
    }

    .heading:not([data-revealed]) .subtitle {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal],
    .titleLine,
    .titleTextInner,
    .subtitle {
      transition: none;
    }
  }

  .heading {
    display: flex;
    flex-direction: column;
    gap: 6px;
    align-items: center;
    margin: 0;
  }

  /* 下線（Figma の Line）は見出しの幅いっぱいに伸ばし、文字との間は 2px あける */
  .title {
    display: flex;
    flex-direction: column;
    gap: 2px;
    align-items: stretch;
    margin: 0;
    font-family: Montserrat, sans-serif;
    font-size: 36px;
    font-weight: 900;
    line-height: 1;
    text-align: center;
    letter-spacing: 0.04em;
  }

  /* 英字を下線の下からせり上がらせるため、下端だけで切り抜く（上と左右は字形がはみ出しても切らない） */
  .titleText {
    display: block;
    clip-path: inset(-0.5em -0.5em 0);
  }

  .titleTextInner {
    display: block;
  }

  .titleLine {
    display: block;
    width: 100%;
    height: 2px;
  }

  .subtitle {
    margin: 0;
    font-family: "Noto Sans JP", sans-serif;
    font-size: 18px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.04em;
  }

  .message {
    display: flex;
    flex-direction: column;
    gap: 48px;
    align-items: center;
    font-family: "Noto Sans JP", sans-serif;
    font-size: 24px;
    font-weight: 700;
    line-height: 1;
    text-align: center;
    letter-spacing: 0.04em;
  }

  .paragraph {
    display: flex;
    flex-direction: column;
    gap: 14px;
    align-items: center;
    margin: 0;
  }

  .paragraph.joined {
    flex-direction: row;
  }

  .line {
    display: block;
    white-space: nowrap;
  }

  /*
   * 開催概要。上下に罫線を引き、項目名の列（80px）と内容を2列のグリッドで並べる。
   * 項目ごとの div は display: contents にして、dt・dd をそのままグリッドに並べる
   */
  .overview {
    display: grid;
    grid-template-columns: 80px minmax(0, 1fr);
    gap: 12px 20px;
    width: 100%;
    max-width: 640px;
    padding: 20px;
    margin: 0;
    font-family: "Noto Sans JP", sans-serif;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: 0.08em;
    border-block: 2px solid var(--color-black);

    /* foundation.css の text-autospace: normal だと「Web」の前後に隙間が入るので、Figma に合わせて切る */
    text-autospace: no-autospace;
  }

  .overviewItem {
    display: contents;
  }

  .overview dd {
    margin: 0;
  }

  /* リンクは set:html で入れるので、scoped の class が付かない。:global で当てる */
  .overview dd :global(a) {
    color: inherit;
    text-decoration: underline;
    text-underline-position: from-font;
  }

  @media (hover: hover) {
    .overview dd :global(a:hover) {
      text-decoration: none;
    }
  }

  /* タブレット以下: メッセージを小さくし、PC で1行につなげていた段落も2行に分ける。開催概要は幅 375px まで */
  @media (width <= 1080px) {
    .content {
      gap: 40px;
    }

    .subtitle {
      font-size: 16px;
    }

    .message {
      gap: 32px;
      font-size: 14px;
    }

    .paragraph {
      gap: 12px;
    }

    .paragraph.joined {
      flex-direction: column;
    }

    .overview {
      max-width: 375px;
      border-block-width: 1px;
    }
  }

  /*
   * iPhone SE など幅や高さが小さい画面: 文字部分が1画面に収まるよう、メッセージと開催概要をさらに詰める。
   * 開催概要は左右に 20px あけて横幅いっぱいに広げる
   */
  @media (width <= 375px), (width <= 1080px) and (height <= 750px) {
    .content {
      gap: 24px;
    }

    .message {
      gap: 20px;
      font-size: 12px;
    }

    .paragraph {
      gap: 6px;
