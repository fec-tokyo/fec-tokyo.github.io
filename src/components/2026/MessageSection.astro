---
/*
 * KV の下に重なって流れてくるメッセージのセクション。
 * 上端に雲を並べ、その下のクリーム色の青海波の面に、見出しとメッセージを中央ぞろえで縦に並べる。
 */
import CloudImage from "@/assets/2026/sections/message/cloud.svg";
import TitleLineImage from "@/assets/2026/sections/message/title-line.svg";
import SeigaihaImage from "@/assets/2026/seigaiha.svg";

// Figma の行の区切りどおりに段落ごと・行ごとに持つ
const paragraphs = [
  [
    "誰でもコードを書ける時代になった｡",
    "フロントエンドは、誰にとっても身近になった｡",
  ],
  [
    "わたしたちは何のためにコードを書くのか？",
    "フロントエンドの未来は、AIが担うのか？",
  ],
  [
    "技術も文化も、人から人へと受け継がれてきた｡",
    "第一線の知見・工夫・問い――",
    "持ち寄り、語り合い、次の世代へ紡いでいく｡",
  ],
  ["AIがつくった未来を生きるのではなく", "AIと共に、未来をつくっていく｡"],
  ["さあ、いまこそ", "“フロントエンドの未来の話をしよう”"],
];
---

<section
  id="message"
  class="container"
  aria-labelledby="message-title"
  style={`--cloud-image: url(${CloudImage.src}); --seigaiha-image: url(${SeigaihaImage.src})`}
>
  {/* セクションの上端に並べる雲。画面幅いっぱいに横に繰り返す */}
  <div class="cloud" aria-hidden="true"></div>
  <div class="body" data-message-body>
    {
      /* 文字がはけた後に、スクロールに合わせて About の藍色に変えていくための面 */
    }
    <div class="dissolve" aria-hidden="true"></div>
    {
      /* 文字部分は画面の上下中央に固定し（JS が動くとき）、hold の分スクロールする間そのまま見せる */
    }
    <div class="pin">
      <div class="content" data-message-content>
        <hgroup class="heading" data-reveal>
          <h2 id="message-title" class="title">
            <span class="titleText">
              <span class="titleTextInner">WHY NOW?</span>
            </span>
            <img
              src={TitleLineImage.src}
              alt=""
              width={TitleLineImage.width}
              height={TitleLineImage.height}
              class="titleLine"
            />
          </h2>
          <p class="subtitle">なぜ、いま、フロカン？</p>
        </hgroup>
        <div class="message">
          {
            paragraphs.map((lines) => (
              <p class="paragraph" data-reveal>
                {lines.map((line) => (
                  <span class="line">{line}</span>
                ))}
              </p>
            ))
          }
        </div>
      </div>
      <div class="hold" aria-hidden="true"></div>
    </div>
  </div>
</section>

<script>
  /*
   * 文字部分（data-message-content）は、画面の上下中央に固定する。画面より高いときは、下端をそろえて全体が見える位置で固定する。
   * 面の上端は文字部分の上に同じだけあけておき、面の上端が画面の上端に届いたちょうどそのときに固定が始まるようにしている。
   *
   * 見出し・段落（data-reveal）は、KV が見えている間は出さず、面の上端が画面の上端に届いたら、
   * そのとき画面に入っているものを上から順に1つずつ出す。前の要素のアニメーションが終わってから REVEAL_GAP だけ待って次を始める。
   * それより下にあったものは画面に入ったら、前の要素が出終わるのを待ってから同じように出す。
   * 画面より上に過ぎた要素も出したことにする（アンカーリンクなどで飛ばしたときや、途中から開いたときのため）。
   *
   * セクションの下端が画面の下端に届くまでの画面 FADE_SCREENS 枚分のスクロールで（固定の終わり際から）、
   * 面を About の藍色にディゾルブさせ（--dissolve: 0 → 1）、同時に文字部分を透明にする。
   * セクションの下端が画面に入る時点では、どちらも変わり切っていて、すぐ下に About の中身が続く。
   */
  const FADE_SCREENS = 0.4;

  // 前の要素が出終わってから次の要素を出し始めるまでの待ち時間（ms）
  const REVEAL_GAP = 100;

  // 見出しのアニメーションの長さ（ms）。CSS の .heading の中身の transition（最後の日本語は 1100ms 後から 600ms）に合わせる
  const HEADING_DURATION = 1700;

  document
    .querySelectorAll<HTMLElement>("[data-message-body]")
    .forEach((body) => {
      const targets = [...body.querySelectorAll<HTMLElement>("[data-reveal]")];
      const seen = new Set<HTMLElement>();
      let ready = false;

      const content = body.querySelector<HTMLElement>("[data-message-content]");

      // 段落のフェードインの長さ（ms）。CSS の --duration-inview から読む（ビルドで 1500ms が 1.5s に書き換わることがあるので単位も見る）
      const durationValue = getComputedStyle(body)
        .getPropertyValue("--duration-inview")
        .trim();
      const paragraphDuration =
        (parseFloat(durationValue) || 0) *
        (durationValue.endsWith("ms") ? 1 : 1000);

      // 最後に出した要素のアニメーションが終わる時刻（performance.now() 基準）
      let queueEnd = -Infinity;

      const reveal = (elements: HTMLElement[]) => {
        const now = performance.now();
        elements
          .sort((a, b) => targets.indexOf(a) - targets.indexOf(b))
          .forEach((el) => {
            const start = Math.max(now, queueEnd + REVEAL_GAP);
            el.style.setProperty("--reveal-delay", `${start - now}ms`);
            el.dataset.revealed = "true";
            queueEnd =
              start +
              (el.matches(".heading") ? HEADING_DURATION : paragraphDuration);
          });
      };

      // 文字部分の高さから、固定する位置（--content-top）と面の上端からの余白（--content-offset）を決める
      const measure = () => {
        if (!content) return;
        const space = innerHeight - content.offsetHeight;
        body.style.setProperty(
          "--content-top",
          `${space >= 0 ? space / 2 : space}px`,
        );
        body.style.setProperty(
          "--content-offset",
          `${Math.max(0, space / 2)}px`,
        );
      };

      // 見えた（または過ぎた）要素を覚え、面が画面を覆った後なら出す
      const markSeen = (elements: HTMLElement[]) => {
        const fresh = elements.filter((el) => !seen.has(el));
        fresh.forEach((el) => seen.add(el));
        if (ready) reveal(fresh);
      };

      const observer = new IntersectionObserver(
        (entries) => {
          markSeen(
            entries
              .filter((entry) => entry.isIntersecting)
              .map((entry) => entry.target as HTMLElement),
          );
        },
        { threshold: 0.2 },
      );
      targets.forEach((el) => observer.observe(el));

      let ticking = false;
      const update = () => {
        ticking = false;
        markSeen(targets.filter((el) => el.getBoundingClientRect().bottom < 0));
        if (!ready && body.getBoundingClientRect().top <= 0) {
          ready = true;
          reveal([...seen]);
        }
        // セクションの下端が、画面の下端より FADE_SCREENS 枚分下にあるときに 0、画面の下端に届いたときに 1
        const progress = Math.min(
          1,
          Math.max(
            0,
            1 -
              (body.getBoundingClientRect().bottom - innerHeight) /
                (innerHeight * FADE_SCREENS),
          ),
        );
        body.style.setProperty("--dissolve", String(progress));
        if (content) content.style.opacity = String(1 - progress);
      };
      const requestUpdate = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      };
      measure();
      update();
      addEventListener("scroll", requestUpdate, { passive: true });
      addEventListener("resize", () => {
        measure();
        requestUpdate();
      });
      document.fonts.ready.then(() => {
        measure();
        requestUpdate();
      });
    });
</script>

<style scoped>
  /*
   * Figma のとおり、高さ 50px の雲の下にセクションの面を続ける。
   * KV の上に重なって流れてくるので、雲のすき間からは KV が透けて見える。
   * 雲の高さの分だけ KV（高さ 100svh）に重ね、ページを開いたときに画面の下端に雲だけが見えるようにする。
   */
  .container {
    --color-message-base: #f6eedd;
    --cloud-height: 50px;

    position: relative;
    margin-top: calc(var(--cloud-height) * -1);
  }

  /*
   * Figma の塗りは「#F6EEDD + 白い青海波のタイル（68×40）を不透明度 40%・オーバーレイで重ねたもの」。
   * 白は地より明るいので、オーバーレイは普通の重ね方と同じ結果になる。
   * 背景画像には不透明度を付けられないので、白い柄の上に 60% の地の色を重ね、柄が 40% だけ透けるようにしている。
   */
  .body {
    position: relative;

    /*
     * 上は、文字部分を画面の上下中央に置いたときの上の余白（JS で決める。JS が動かないときは 120px）。
     * 下は、文字の固定が外れてからセクションが終わるまでの少しの余白（画面の高さの 10%）
     */
    padding: var(--content-offset, 120px) 20px 10svh;
    color: var(--color-black);
    background-color: var(--color-message-base);
    background-image:
      linear-gradient(
        color-mix(in srgb, var(--color-message-base) 60%, transparent),
        color-mix(in srgb, var(--color-message-base) 60%, transparent)
      ),
      var(--seigaiha-image);
    background-position: top center;
  }

  /*
   * 雲。SVG は1つ分の部品（幅 240px・高さ 50px）で、それをマスクにして横に繰り返し、雲の形に切り抜く。
   * 塗りは Figma と同じく、上端から 10px までは白・下端で地の色になるグラデーションに、白い青海波を 40% で重ねる。
   * 面と同じく、柄の上にグラデーションを 60% で重ねて柄を 40% だけ透かし、いちばん下に同じグラデーションを敷いている。
   * 青海波は面の柄と継ぎ目なくつながるよう、面の上端（雲の上から 50px）を起点にしている。
   */
  .cloud {
    --cloud-gradient-opacity: 60%;

    height: var(--cloud-height);
    pointer-events: none;
    background-image:
      linear-gradient(
        color-mix(
            in srgb,
            var(--color-white) var(--cloud-gradient-opacity),
            transparent
          )
          10px,
        color-mix(
          in srgb,
          var(--color-message-base) var(--cloud-gradient-opacity),
          transparent
        )
      ),
      var(--seigaiha-image),
      linear-gradient(var(--color-white) 10px, var(--color-message-base));
    background-position:
      0 0,
      center var(--cloud-height),
      0 0;
    mask-image: var(--cloud-image);
    mask-repeat: repeat-x;
    mask-position: top center;
    mask-size: 240px var(--cloud-height);
  }

  /* ディゾルブ先の面。About と同じ藍色 + ノイズ（.background-aizome と同じ）を、--dissolve の不透明度で重ねる */
  .dissolve {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-color: var(--color-aizome);
    background-image: var(--texture-noise-subtle);
    opacity: var(--dissolve, 0);
  }

  /* 文字部分はディゾルブの面より手前に置く */
  .pin {
    position: relative;
    width: 100%;
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: 64px;
    align-items: center;
  }

  /* 固定は JS が位置を決めるときだけ。hold の高さ分スクロールする間、文字部分を固定したまま見せる */
  @media (scripting: enabled) {
    .content {
      position: sticky;
      top: var(--content-top, 0);
    }

    .hold {
      height: 100svh;
    }
  }

  /* 文字は下から少し浮き上がりながらフェードインさせる。JS が動かない環境では最初から表示しておく */
  [data-reveal] {
    transition:
      opacity var(--duration-inview) var(--easing-out),
      translate var(--duration-inview) var(--easing-out);
    transition-delay: var(--reveal-delay, 0ms);
  }

  @media (scripting: enabled) {
    [data-reveal]:not([data-revealed]) {
      opacity: 0;
      translate: 0 24px;
    }
  }

  /*
   * 見出しは全体を動かさず、中身を順に出す。
   * 1. 下線が中央から左右へ伸びる  2. 英字が下線の下からせり上がる  3. 日本語がフェードインする
   */
  .heading {
    --heading-delay: var(--reveal-delay, 0ms);
  }

  .titleLine {
    transition: scale 600ms var(--easing-out) var(--heading-delay);
  }

  .titleTextInner {
    transition: translate 700ms var(--easing-out)
      calc(var(--heading-delay) + 600ms);
  }

  .subtitle {
    transition: opacity 600ms var(--easing-out)
      calc(var(--heading-delay) + 1100ms);
  }

  @media (scripting: enabled) {
    .heading[data-reveal]:not([data-revealed]) {
      opacity: 1;
      translate: none;
    }

    .heading:not([data-revealed]) .titleLine {
      scale: 0 1;
    }

    .heading:not([data-revealed]) .titleTextInner {
      translate: 0 100%;
    }

    .heading:not([data-revealed]) .subtitle {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal],
    .titleLine,
    .titleTextInner,
    .subtitle {
      transition: none;
    }
  }

  .heading {
    display: flex;
    flex-direction: column;
    gap: 6px;
    align-items: center;
    margin: 0;
  }

  /* 下線（Figma の Line）は見出しの幅いっぱいに伸ばし、文字との間は 2px あける */
  .title {
    display: flex;
    flex-direction: column;
    gap: 2px;
    align-items: stretch;
    margin: 0;
    font-family: Montserrat, sans-serif;
    font-size: 32px;
    font-weight: 900;
    line-height: 1;
    text-align: center;
    letter-spacing: 0.04em;
  }

  /* 英字を下線の下からせり上がらせるため、下端だけで切り抜く（上と左右は字形がはみ出しても切らない） */
  .titleText {
    display: block;
    clip-path: inset(-0.5em -0.5em 0);
  }

  .titleTextInner {
    display: block;
  }

  .titleLine {
    display: block;
    width: 100%;
    height: 2px;
  }

  .subtitle {
    margin: 0;
    font-family: "Noto Sans JP", sans-serif;
    font-size: 16px;
    font-weight: 900;
    line-height: 1;
    letter-spacing: 0.04em;
  }

  .message {
    display: flex;
    flex-direction: column;
    gap: 40px;
    align-items: center;
    font-family: "Noto Sans JP", sans-serif;
    font-size: 20px;
    font-weight: 700;
    line-height: 1;
    text-align: center;
    letter-spacing: 0.04em;
  }

  .paragraph {
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: center;
    margin: 0;
  }

  .line {
    display: block;
    white-space: nowrap;
  }

  /*
   * モバイル: デザインはまだないので、メッセージは Figma の行のまま折り返さず、
   * いちばん長い行（21文字 + 字間）が幅に収まるよう、画面幅に合わせて文字を小さくする（最大 16px）
   */
  @media (width <= 720px) {
    .content {
      gap: 48px;
    }

    .message {
      gap: 32px;
      font-size: min(16px, (100vw - 40px) / 22.5);
    }
  }
</style>
