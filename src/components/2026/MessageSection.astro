---
/*
 * 端末ごとに改行位置が違うので、Figma の行の区切りどおりに行ごとのデータを持ち、端末ごとに組んで出し分ける。
 * 見た目の文は読み上げで3回読まれないよう aria-hidden にし、読み上げ用の文を別に置いている。
 */
type Segment = { text: string; highlight?: boolean };
type Paragraph = { lines: Segment[][]; wide?: boolean };

const text = (value: string): Segment => ({ text: value });
const highlight = (value: string): Segment => ({
  text: value,
  highlight: true,
});

// デスクトップとタブレットは2段落目の2行目だけが違う
const firstParagraph: Paragraph = {
  lines: [
    [highlight("誰でもコードを書ける時代"), text("になった。")],
    [highlight("フロントエンドの輪郭"), text("も変わりつつある。")],
  ],
};
const lastParagraph: Paragraph = {
  wide: true,
  lines: [
    [highlight("未来のフロントエンド"), text("の担い手は、私たちだ。")],
    [text("いまこそフロントエンドの"), highlight("“未来の話をしよう”")],
  ],
};

const layouts: { name: string; paragraphs: Paragraph[] }[] = [
  {
    name: "desktop",
    paragraphs: [
      firstParagraph,
      {
        lines: [
          [
            text("それでも"),
            highlight("技術の創造"),
            text("や"),
            highlight("発想の探求"),
            text("は止まらない。"),
          ],
          [
            text("フロントエンドは"),
            highlight("もっと鋭く"),
            highlight("もっと便利"),
            text("に進化していける。"),
          ],
        ],
      },
      lastParagraph,
    ],
  },
  {
    name: "tablet",
    paragraphs: [
      firstParagraph,
      {
        lines: [
          [
            text("それでも"),
            highlight("技術の創造"),
            text("や"),
            highlight("発想の探求"),
            // 全角の句点だと幅に収まらないので、Figma と同じく半角の句点にして詰める
            text("は止まらない｡"),
          ],
          [
            text("フロントエンドは"),
            highlight("もっと鋭く"),
            highlight("もっと便利"),
            text("に"),
          ],
          [text("もっと進化していける。")],
        ],
      },
      lastParagraph,
    ],
  },
  {
    /*
     * 幅に収まるよう、Figma ではモバイルだけ「は私たちだ。」の読点を省き、「なった｡」は半角の句点にしている
     */
    name: "mobile",
    paragraphs: [
      {
        lines: [
          [highlight("誰でもコードを書ける時代"), text("に")],
          [text("なった｡"), highlight("フロントエンドの輪郭")],
          [text("も変わりつつある。")],
        ],
      },
      {
        lines: [
          [text("それでも"), highlight("技術の創造"), text("や")],
          [highlight("発想の探求"), text("は止まらない。")],
          [text("フロントエンドは"), highlight("もっと鋭く")],
          [highlight("もっと便利"), text("に進化していける。")],
        ],
      },
      {
        lines: [
          [highlight("未来のフロントエンド"), text("の担い手")],
          [text("は私たちだ。いまこそフロント")],
          [text("エンドの"), highlight("“未来の話をしよう”")],
        ],
      },
    ],
  },
];
---

<section
  id="message"
  class="container"
  aria-labelledby="message-title"
  data-message-section
>
  {/* デザインには見出しも読み上げ用の文もないので、見た目からは消して読み上げには残す */}
  <div class="visuallyHidden">
    <h2 id="message-title">Why now?</h2>
    <p>
      誰でもコードを書ける時代になった。フロントエンドの輪郭も変わりつつある。
    </p>
    <p>
      それでも技術の創造や発想の探求は止まらない。フロントエンドはもっと鋭く、もっと便利に進化していける。
    </p>
    <p>
      未来のフロントエンドの担い手は、私たちだ。いまこそフロントエンドの“未来の話をしよう”
    </p>
  </div>
  {
    layouts.map((layout) => (
      <div class={`body ${layout.name}`} aria-hidden="true">
        {layout.paragraphs.map((paragraph) => (
          <div class:list={["paragraph", { wide: paragraph.wide }]}>
            {paragraph.lines.map((line) => (
              <div class="line">
                {line.map((segment) => (
                  <span class={segment.highlight ? "highlight" : "text"}>
                    {segment.text}
                  </span>
                ))}
              </div>
            ))}
          </div>
        ))}
      </div>
    ))
  }
</section>

<script>
  document
    .querySelectorAll<HTMLElement>("[data-message-section]")
    .forEach((section) => {
      const bodies = section.querySelectorAll<HTMLElement>(".body");

      // 端末ごとの本文それぞれで、地の文と強調部分に読む順の番号を振り、1つずつ遅らせて出す
      bodies.forEach((body) => {
        body
          .querySelectorAll<HTMLElement>(".text, .highlight")
          .forEach((el, i) => {
            el.style.setProperty("--index", String(i));
          });
      });

      // セクション全体だと上の余白だけで発火してしまうので、表示中の本文が 3 割見えたら表示し、以降は監視しない
      const observer = new IntersectionObserver(
        (entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          section.dataset.inview = "true";
          observer.disconnect();
        },
        { threshold: 0.3 },
      );
      bodies.forEach((body) => observer.observe(body));
    });
</script>

<style scoped>
  /*
   * 余白・文字・ハイライトの大きさはすべて、端末ごとのデザインの幅を基準にした単位（--unit）で指定する。
   * --unit はデザインの幅のときに 1px で、次の端末のデザインに切り替わるまで画面幅に比例して変わる。
   * 文字も余白も同じ比率で伸び縮みするので、どの幅でも Figma と同じ位置で改行し、行が幅からはみ出さない。
   * 行は Figma のとおりに組み、行の中では折り返さない（white-space: nowrap）。
   */
  .container {
    position: relative;
    container-type: inline-size;
  }

  .visuallyHidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    white-space: nowrap;
    clip-path: inset(50%);
  }

  /* デスクトップ: 1440px のデザイン。1440px より広い画面では .max-width で 1440px に止まる */
  .body {
    --design-width: 1440;
    --unit: calc(100cqi / var(--design-width));

    /* 文字 40px、ハイライトの余白 8px 12px、文節の間 4px（最後の段落は 8px） */
    --font-size: 40;
    --highlight-padding-block: 8;
    --highlight-padding-inline: 12;
    --segment-gap: 4;
    --segment-gap-wide: 8;
    --line-gap: 4;
    --paragraph-gap: 48;

    display: flex;
    flex-direction: column;
    gap: calc(var(--paragraph-gap) * var(--unit));
    padding: calc(82 * var(--unit)) calc(120 * var(--unit))
      calc(240 * var(--unit));
    font-family: "Noto Sans JP", sans-serif;
    font-size: calc(var(--font-size) * var(--unit));
    font-weight: 900;
    line-height: 1;
    color: var(--color-off-white);
    letter-spacing: 0.04em;
  }

  .tablet,
  .mobile {
    display: none;
  }

  .paragraph {
    display: flex;
    flex-direction: column;
    gap: calc(var(--line-gap) * var(--unit));
    align-items: flex-start;
  }

  /* 1行の高さはハイライトの高さ（文字 + 上下の余白）にそろえ、地の文は縦の中央に置く */
  .line {
    display: flex;
    gap: calc(var(--segment-gap) * var(--unit));
    align-items: center;
    height: calc(
      (var(--font-size) + var(--highlight-padding-block) * 2) * var(--unit)
    );
    white-space: nowrap;
  }

  .wide .line {
    gap: calc(var(--segment-gap-wide) * var(--unit));
  }

  .text {
    transition: opacity var(--duration-inview) var(--easing-out);
    transition-delay: calc(var(--index, 0) * var(--stagger, 80ms));
  }

  /* 白背景は ::before で敷き、セクションが画面に入ったら左から右へ伸ばす */
  .highlight {
    position: relative;
    padding: calc(var(--highlight-padding-block) * var(--unit))
      calc(var(--highlight-padding-inline) * var(--unit));
    color: var(--color-orange);
    isolation: isolate;
  }

  .highlight::before {
    position: absolute;
    inset: 0;
    z-index: -1;
    content: "";
    background-color: var(--color-off-white);
    transform-origin: left;
    transition: transform var(--duration-inview) var(--easing-out);
    transition-delay: calc(var(--index, 0) * var(--stagger, 80ms));
  }

  /* 地の文はフェードインさせる。JS が動かない環境では最初から表示しておく */
  @media (scripting: enabled) {
    .container:not([data-inview]) .text {
      opacity: 0;
    }

    .container:not([data-inview]) .highlight::before {
      transform: scaleX(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .text,
    .highlight::before {
      transition: none;
    }
  }

  /* タブレット: 834px のデザイン */
  @media (width <= 1080px) {
    .desktop {
      display: none;
    }

    .tablet {
      --design-width: 834;
      --font-size: 32;
      --highlight-padding-block: 6;
      --highlight-padding-inline: 8;
      --paragraph-gap: 32;

      display: flex;
      padding: calc(40 * var(--unit)) calc(40 * var(--unit))
        calc(200 * var(--unit));
    }
  }

  /* モバイル: 440px のデザイン */
  @media (width <= 720px) {
    .tablet {
      display: none;
    }

    .mobile {
      --design-width: 440;
      --font-size: 26;
      --highlight-padding-block: 4;
      --highlight-padding-inline: 4;
      --line-gap: 6;

      display: flex;
      padding: calc(80 * var(--unit)) calc(20 * var(--unit))
        calc(160 * var(--unit));
    }
  }
</style>
