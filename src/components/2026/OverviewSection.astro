---
import DividerImage from "@/assets/2026/sections/overview/divider.svg";
import TitleImage from "@/assets/2026/sections/overview/title.svg";

const items = [
  { label: "開催日時", value: "2026年12月09日（土）10:00~18:00（予定）" },
  { label: "会場", value: "住友不動産渋谷タワー（Abema Towers）" },
  {
    label: "対象",
    value: "フロントエンドやWeb技術に携わる全てのエンジニア・デザイナー",
  },
  {
    label: "主催",
    value: "フロントエンドカンファレンス東京実行委員会（主宰：平井 柊太）",
  },
];
---

<section
  id="overview"
  class="container background-seigaiha"
  aria-labelledby="overview-title"
  style={`--divider-image: url(${DividerImage.src})`}
>
  <h2 id="overview-title" class="title">
    <img
      src={TitleImage.src}
      alt="開催概要"
      width={TitleImage.width}
      height={TitleImage.height}
      class="titleImage"
    />
  </h2>
  <dl class="list">
    {
      items.map((item) => (
        <div class="item">
          <dt class="label">{item.label}</dt>
          <dd class="value">{item.value}</dd>
        </div>
      ))
    }
  </dl>
</section>

<style scoped>
  .container {
    display: flex;
    gap: 80px;
    align-items: center;
    padding: 40px 80px;
    color: var(--color-off-white);
    border: 2px solid var(--color-off-white);
    border-radius: 24px;
  }

  .title {
    flex-shrink: 0;
    margin: 0;
  }

  .titleImage {
    display: block;
    width: 200px;
    height: auto;
  }

  .list {
    display: flex;
    flex: 1 1 0;
    flex-direction: column;

    /* 項目の間 32px（点線の上下に 16px ずつ） */
    gap: 32px;
    min-width: 0;
    margin: 0;
    font-family: "Noto Sans JP", sans-serif;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.04em;
  }

  .item {
    display: flex;
    gap: 16px;
  }

  /*
   * 項目の間の点線（Figma の Line）。上の項目との間 32px の真ん中に置く。
   * SVG は幅 756px で、それより広いときは横に繰り返す。
   */
  .item + .item {
    position: relative;
  }

  .item + .item::before {
    position: absolute;
    top: -17px;
    left: 0;
    width: 100%;
    height: 1px;
    content: "";
    background-image: var(--divider-image);
    background-repeat: repeat-x;
  }

  .label {
    flex-shrink: 0;
    width: 120px;
  }

  .value {
    min-width: 0;
    margin: 0;

    /* foundation.css の text-autospace: normal だと「Web」の前後に隙間が入るので、Figma に合わせて切る */
    text-autospace: no-autospace;
  }

  /* タブレット: 表だけを置き、項目名の列を狭める */
  @media (width <= 1080px) {
    .container {
      padding: 40px;
    }

    /* タブレットのデザインには見出しの画像がないので、見た目からは消して読み上げには残す */
    .title {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      white-space: nowrap;
      clip-path: inset(50%);
    }

    .list {
      font-size: 16px;
    }

    .item {
      gap: 32px;
    }

    .label {
      width: 80px;
    }
  }

  /* モバイル: 項目名と内容も縦に積む */
  @media (width <= 840px) {
    .container {
      padding: 32px 20px;
    }

    .list {
      font-size: 16px;
    }

    .item {
      flex-direction: column;
      gap: 8px;
    }

    .label {
      width: auto;
    }
  }
</style>
