---
import DividerImage from "@/assets/2026/sections/overview/divider.svg";

const items = [
  { label: "開催日時", value: "2026年12月05日（土）10:00~18:00" },
  { label: "会場", value: "住友不動産渋谷タワー Abema Towers" },
  {
    label: "対象",
    value: "フロントエンドやWeb技術に携わる全てのエンジニア・デザイナー",
  },
  {
    label: "主催",
    value: "フロントエンドカンファレンス東京実行委員会（主宰：平井 柊太）",
  },
];
---

<section
  id="overview"
  class="container background-seigaiha"
  aria-labelledby="overview-title"
  style={`--divider-image: url(${DividerImage.src})`}
>
  {/* デザインには見出しがないので、見た目からは消して読み上げには残す */}
  <h2 id="overview-title" class="title">開催概要</h2>
  <dl class="list">
    {
      items.map((item) => (
        <div class="item">
          <dt class="label">{item.label}</dt>
          <dd class="value">{item.value}</dd>
        </div>
      ))
    }
  </dl>
</section>

<style scoped>
  .container {
    position: relative;
    padding: 40px;
    container-type: inline-size;
    color: var(--color-off-white);
    border: 2px solid var(--color-off-white);
    border-radius: 24px;
  }

  .title {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    white-space: nowrap;
    clip-path: inset(50%);
  }

  .list {
    display: flex;
    flex-direction: column;

    /* 項目の間 33px（点線 1px の上下に 16px ずつ） */
    gap: 33px;
    min-width: 0;
    margin: 0;
    font-family: "Noto Sans JP", sans-serif;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.04em;
  }

  .item {
    display: flex;
    gap: 16px;
  }

  /*
   * 項目の間の点線（Figma の Line）。上の項目との間 33px の真ん中に置く。
   * SVG は幅 756px で、それより広いときは横に繰り返す。
   */
  .item + .item {
    position: relative;
  }

  .item + .item::before {
    position: absolute;
    top: -17px;
    left: 0;
    width: 100%;
    height: 1px;
    content: "";
    background-image: var(--divider-image);
    background-repeat: repeat-x;
  }

  .label {
    flex-shrink: 0;
    width: 120px;
  }

  /* モバイルになるまでは、内容を1行に収めて折り返さない */
  .value {
    min-width: 0;
    margin: 0;
    white-space: nowrap;

    /* foundation.css の text-autospace: normal だと「Web」の前後に隙間が入るので、Figma に合わせて切る */
    text-autospace: no-autospace;
  }

  /* タブレット: 項目名の列を狭める */
  @media (width <= 1080px) {
    /*
     * 内容は折り返さないので、いちばん長い行（主催、16px で約 31.4 文字分）が
     * 項目名の列（80px）と間（32px）を除いた幅に収まるよう、狭い画面では文字を小さくする
     */
    .list {
      font-size: min(16px, (100cqi - 80px - 32px) / 31.5);
    }

    .item {
      gap: 32px;
    }

    .label {
      width: 80px;
    }
  }

  /* モバイル: 項目名と内容は横に並べたまま、文字と項目名の列を小さくする */
  @media (width <= 720px) {
    .container {
      padding: 20px;
    }

    .list {
      font-size: 14px;
    }

    .item {
      gap: 16px;
      align-items: center;
    }

    .label {
      width: 60px;
    }

    .value {
      white-space: normal;
    }
  }
</style>
