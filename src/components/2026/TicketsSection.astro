---
import LinkCard from "@/components/2026/LinkCard.astro";
import { TICKET_URL } from "@/data/2026/links";
import { TrackEvent, TrackLocation } from "@/data/tracking";
---

<LinkCard
  id="tickets"
  title="Tickets"
  description="アーリーバードチケットを販売中！"
  label="チケットを購入する"
  href={TICKET_URL}
  trackEvent={TrackEvent.TicketClick}
  trackLocation={TrackLocation.Tickets}
/>
