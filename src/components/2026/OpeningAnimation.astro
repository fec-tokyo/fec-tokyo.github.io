---
import LogomarkOnetone from "@/assets/logo/logomark-onetone.svg";

// 捲れた布の陰影のグラデーションに置く色の段の数。多いほど丸みの陰が滑らかになる
const SHADE_STOPS = 12;
---

{
  /*
   * ページを開いたときに一度だけ流すオープニング。
   * 1. 真っ暗な画面に、オレンジの壁が下から上へ伸びる
   * 2. 壁の中央に白いロゴマークがフェードインし、少し止まってからフェードアウトする
   * 3. 壁が縦に4枚（モバイルは2枚）に割れ、のれん1枚ずつ裾から手前へくるりと丸まって
   *    捲れ上がり、揺れながらはけていく。捲れる向きと順番は script の CURTAINS_* で決める
   * それぞれの時間は script の DURATION_* で決める。
   * 流しはじめにページを一番上までスクロールし、流れている間はスクロールさせない。
   * のれんの形と陰影は毎フレーム SVG を描き直して作る（下の script）。
   * 飾りなので支援技術には読ませない。
   */
}
<div class="opening" aria-hidden="true" data-opening>
  {
    /* script が動くまでは画面いっぱいに引き伸ばして黒で覆う。動いたら座標を画面のピクセルに合わせる */
  }
  <svg viewBox="0 0 100 100" preserveAspectRatio="none" data-opening-svg>
    <defs>
      {
        /*
         * 1枚ごとの、捲れて見えている裏に重ねる陰。黒の濃さを段ごとに変える。
         * 向き・位置・濃さは script で毎フレーム決める
         */
        [0, 1, 2, 3].map((index) => (
          <linearGradient
            id={`opening-shade-${index}`}
            gradientUnits="userSpaceOnUse"
          >
            {Array.from({ length: SHADE_STOPS }, () => (
              <stop class="shade" />
            ))}
          </linearGradient>
        ))
      }
    </defs>
    <rect class="backdrop" width="100" height="100" data-opening-backdrop
    ></rect>
    <rect class="front" y="100" width="100" height="100" data-opening-wall
    ></rect>
    {
      /*
       * 後に書いたものほど上に重なる。中央の2枚は外側へ寄って捲れるので、
       * 隣の外側の1枚より上に重ねる（左から 1, 4, 2, 3 枚目の順）
       */
      [0, 3, 1, 2].map((index) => (
        <g data-opening-curtain={index}>
          <path class="front" />
          <path class="front" />
          <path fill={`url(#opening-shade-${index})`} />
          <path class="shadow" />
          <path class="back" />
          <path fill={`url(#opening-shade-${index})`} />
        </g>
      ))
    }
  </svg>
  {/* 壁の上に重ねるロゴマーク。濃さは script で変える */}
  <LogomarkOnetone class="logo" data-opening-logo />
</div>

<style>
  .opening {
    position: fixed;
    inset: 0;
    z-index: 1000;

    /* script が動かなかったときに画面を覆ったままにしない */
    animation: opening-hide 0s 6s forwards;
  }

  svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* 画面の中央に幅 320px で置く。高さは viewBox の比率に合わせて決まる */
  .logo {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 320px;
    height: auto;
    color: var(--color-white);
    opacity: 0;
    translate: -50% -50%;
  }

  .backdrop {
    fill: var(--color-black);
  }

  .front {
    fill: var(--color-orange);
  }

  /* 返った裾が表に落とす影。ぼかすと iOS Safari で毎フレームの描き直しが重いので、ずらして重ねるだけにする */
  .shadow {
    fill: rgb(0 0 0 / 20%);
  }

  .back {
    fill: var(--color-red);
  }

  .shade {
    stop-color: var(--color-black);
  }

  @keyframes opening-hide {
    to {
      visibility: hidden;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .opening {
      display: none;
    }
  }
</style>

<script>
  const DURATION_RISE = 1000;
  const DURATION_LOGO_IN = 500;
  // フェードインしきってからフェードアウトしはじめるまで止めておく時間
  const DURATION_LOGO_HOLD = 500;
  const DURATION_LOGO_OUT = 500;
  const DURATION_NOREN = 1000;
  // のれんが捲れはじめる時刻
  const NOREN_START =
    DURATION_RISE + DURATION_LOGO_IN + DURATION_LOGO_HOLD + DURATION_LOGO_OUT;

  /*
   * 1枚ごとの設定。左から順に並べ、並べた数だけのれんを割る
   * - delay: 捲れはじめの遅れ（のれん全体の時間に対する割合）
   * - sway: 揺れの大きさと向き
   * - angle: 捲れ上がる向き（真上から何度傾けるか。負は左、正は右）
   */
  // 4枚。外側の2枚はそれぞれの端へ斜め上に、中央の2枚は上へ少し端寄りに捲れる。中央の2枚から先に捲れる
  const CURTAINS_DESKTOP = [
    { delay: 0.12, sway: 1, angle: -25 },
    { delay: 0, sway: -0.8, angle: -8 },
    { delay: 0.03, sway: 0.9, angle: 8 },
    { delay: 0.15, sway: -1.1, angle: 25 },
  ];
  // モバイルは幅が狭いので2枚。それぞれの端へ斜め上に捲れる
  const CURTAINS_MOBILE = [
    { delay: 0, sway: 1, angle: -15 },
    { delay: 0.03, sway: -1.1, angle: 15 },
  ];
  const CURTAINS = window.matchMedia("(width <= 720px)").matches
    ? CURTAINS_MOBILE
    : CURTAINS_DESKTOP;
  // 裾の揺れ幅（画面幅に対する割合）
  const SWAY_AMOUNT = 0.012;
  // 丸まった部分の半径（画面の高さに対する割合）
  const CURL_RADIUS = 0.04;
  // 陰の濃さ（0〜1）。返った裾の端は明るく、折り目、谷へ向かって濃くなる
  const CREASE_DARKNESS = 0.08;
  const VALLEY_DARKNESS = 0.4;
  // 返った裾が表に落とす影のずれ（px）
  const SHADOW_OFFSET = 4;
  // 割れたのれんの隙間（画面幅に対する割合、片側ぶん）
  const GAP = 0.003;
  // 布の辺を曲げるときの分割数
  const SEGMENTS = 24;

  const opening = document.querySelector<HTMLElement>("[data-opening]");
  const svg = opening?.querySelector("[data-opening-svg]");
  const backdrop = opening?.querySelector("[data-opening-backdrop]");
  const wall = opening?.querySelector("[data-opening-wall]");
  const logo = opening?.querySelector<SVGElement>("[data-opening-logo]");
  // 重なり順で並んでいるので、左からの順に並べ直す
  const curtainGroups = [
    ...(opening?.querySelectorAll<SVGGElement>("[data-opening-curtain]") ?? []),
  ].sort(
    (a, b) =>
      Number(a.dataset.openingCurtain) - Number(b.dataset.openingCurtain),
  );
  // 使わない枚数ぶんは外す
  curtainGroups.slice(CURTAINS.length).forEach((curtain) => curtain.remove());
  const curtains = curtainGroups
    .slice(0, CURTAINS.length)
    .map((curtain) => curtain.querySelectorAll("path"));
  const shades = [...(opening?.querySelectorAll("linearGradient") ?? [])].map(
    (gradient) => ({ gradient, stops: gradient.querySelectorAll("stop") }),
  );

  const easeOutCubic = (t: number) => 1 - (1 - t) ** 3;
  const easeInOutSine = (t: number) => -(Math.cos(Math.PI * t) - 1) / 2;
  const clamp = (value: number, min: number, max: number) =>
    Math.min(Math.max(value, min), max);

  type Point = [x: number, y: number];

  const dot = ([x1, y1]: Point, [x2, y2]: Point) => x1 * x2 + y1 * y2;
  const lerp = ([x1, y1]: Point, [x2, y2]: Point, t: number): Point => [
    x1 + (x2 - x1) * t,
    y1 + (y2 - y1) * t,
  ];

  const toPath = (points: Point[]) =>
    points.length > 2
      ? `M ${points.map(([x, y]) => `${x.toFixed(1)} ${y.toFixed(1)}`).join(" L ")} Z`
      : "";

  // 凸な多角形のうち、distance(p) >= 0 の側だけを切り出す
  const clip = (polygon: Point[], distance: (p: Point) => number) => {
    const result: Point[] = [];
    polygon.forEach((current, i) => {
      const next = polygon[(i + 1) % polygon.length];
      const a = distance(current);
      const b = distance(next);
      if (a >= 0) result.push(current);
      if (a >= 0 !== b >= 0) result.push(lerp(current, next, a / (a - b)));
    });
    return result;
  };

  // 多角形の辺を細かく分ける。曲げたときに辺がなめらかな曲線になるように
  const subdivide = (polygon: Point[]) =>
    polygon.flatMap((current, i) => {
      const next = polygon[(i + 1) % polygon.length];
      return Array.from({ length: SEGMENTS }, (_, j) =>
        lerp(current, next, j / SEGMENTS),
      );
    });

  /*
   * 捲れた裏に重ねる陰。返った裾の端から折り目、丸まりの谷へ向かって暗くする。
   * 横から見ると布は半円を描いて返っていて、正面からは半円の下半分が見える。
   * 面の向きは谷に近づくほど急に下を向くので、陰も谷のそばで急に濃くなる（円の式）。
   * 段ごとの濃さは変わらないので最初に一度だけ決め、毎フレームは位置だけ動かす。
   */
  shades.forEach(({ stops }) => {
    stops[0].setAttribute("offset", "0");
    stops[0].setAttribute("stop-opacity", "0");
    for (let i = 1; i < stops.length; i++) {
      const u = (i - 1) / (stops.length - 2);
      stops[i].setAttribute(
        "stop-opacity",
        `${CREASE_DARKNESS + (VALLEY_DARKNESS - CREASE_DARKNESS) * (1 - Math.sqrt(1 - u * u))}`,
      );
    }
  });

  const setShade = (
    { gradient, stops }: (typeof shades)[number],
    hem: Point,
    crease: Point,
    valley: Point,
  ) => {
    gradient.setAttribute("x1", `${hem[0]}`);
    gradient.setAttribute("y1", `${hem[1]}`);
    gradient.setAttribute("x2", `${valley[0]}`);
    gradient.setAttribute("y2", `${valley[1]}`);
    const total = Math.hypot(valley[0] - hem[0], valley[1] - hem[1]) || 1;
    const creaseOffset = clamp(
      Math.hypot(crease[0] - hem[0], crease[1] - hem[1]) / total,
      0,
      1,
    );
    for (let i = 1; i < stops.length; i++) {
      const u = (i - 1) / (stops.length - 2);
      stops[i].setAttribute(
        "offset",
        `${creaseOffset + (1 - creaseOffset) * u}`,
      );
    }
  };

  /*
   * 1枚ののれんを描く。q はその1枚の捲れの進み具合（0〜1）。
   * 折り目の線が、捲れる向き direction へ裾から進んでいき、線より後ろの布は
   * 手前へ半円を描いて丸まって返り、裏を見せながら表に重なる。
   * 布の長さは変わらないので、折り目が進むほど返った裾は長くなり、最後は画面の外へ抜けていく。
   */
  const drawCurtain = (
    paths: NodeListOf<SVGPathElement>,
    index: number,
    q: number,
    size: { width: number; height: number; gap: number; swing: number },
  ) => {
    const [front, roll, rollShade, shadow, back, shade] = paths;
    // 捲れきったら布はすべて画面の外なので、消して以降は描かない
    if (q >= 1) {
      if (back.hasAttribute("d")) {
        paths.forEach((path) => path.removeAttribute("d"));
      }
      return;
    }
    const { width, height, gap, swing } = size;
    const { sway, angle } = CURTAINS[index];
    const left = (index * width) / CURTAINS.length + gap;
    const right = ((index + 1) * width) / CURTAINS.length - gap;
    const strip: Point[] = [
      [left, 0],
      [right, 0],
      [right, height],
      [left, height],
    ];

    const radian = (angle * Math.PI) / 180;
    const direction: Point = [Math.sin(radian), -Math.cos(radian)];
    // 丸まりの半径。捲れはじめに膨らみ、捲れきるころにしぼむ
    const radius =
      CURL_RADIUS *
      height *
      easeOutCubic(clamp(q * 8, 0, 1)) *
      clamp((1 - q) / 0.25, 0, 1);

    // 折り目の線の位置。裾のいちばん奥から、布がすべて返って画面の外へ抜けるところまで進める
    const reach = strip.map((p) => dot(p, direction));
    const start = Math.min(...reach);
    const end = Math.max(...reach) + height * 0.2;
    const crease = start + (end - start) * q;
    const distance = (p: Point) => dot(p, direction) - crease;

    // 揺れ。上端は留まっていて、下へいくほど大きくずれる
    const swayed = ([x, y]: Point): Point => [
      x + SWAY_AMOUNT * width * sway * swing * clamp(y / height, 0, 1) ** 1.5,
      y,
    ];

    // 表。折り目より手前の布
    front.setAttribute("d", toPath(clip(strip, distance).map(swayed)));

    /*
     * 返った布。折り目から δ だけ後ろにあった点は、丸まりの半円に沿って
     * 折り目から -r·sin(δ/r) の位置に来て、半円を回りきったあとは折り目の先へ δ - πr 伸びる。
     * 半円の下（谷）までは表が奥へ回り込み（δ < πr/2）、谷を過ぎると裏が手前を上っていく（δ >= πr/2）。
     * 回り込む側はほとんど裏に隠れるが、端が見えて表と裏をつなぐので、別に描いて重ねる
     */
    const quarter = (Math.PI * radius) / 2;
    const rolling = clip(
      clip(strip, (p) => -distance(p)),
      (p) => distance(p) + quarter,
    );
    const turned = clip(strip, (p) => -distance(p) - quarter);
    const fold = (p: Point): Point => {
      const behind = -distance(p);
      const along =
        behind < Math.PI * radius
          ? -radius * Math.sin(behind / radius)
          : behind - Math.PI * radius;
      return [
        p[0] + direction[0] * (along + behind),
        p[1] + direction[1] * (along + behind),
      ];
    };
    const rollPath = toPath(subdivide(rolling).map(fold).map(swayed));
    roll.setAttribute("d", rollPath);
    rollShade.setAttribute("d", rollPath);

    const folded = subdivide(turned).map(fold).map(swayed);
    const backPath = toPath(folded);
    back.setAttribute("d", backPath);
    shade.setAttribute("d", backPath);
    shadow.setAttribute("d", backPath);
    shadow.setAttribute(
      "transform",
      `translate(${-direction[0] * SHADOW_OFFSET} ${SHADOW_OFFSET})`,
    );

    // 陰は、捲れる向きに沿って、返った裾のいちばん先から谷までにかける
    if (folded.length > 0) {
      const center: Point = [(left + right) / 2, height / 2];
      const onCrease: Point = [
        center[0] + direction[0] * -distance(center),
        center[1] + direction[1] * -distance(center),
      ];
      const tip = Math.max(...folded.map((p) => distance(p)), 0);
      const at = (offset: number): Point =>
        swayed([
          onCrease[0] + direction[0] * offset,
          onCrease[1] + direction[1] * offset,
        ]);
      setShade(shades[index], at(tip), at(0), at(-radius));
    }
  };

  const drawCurtains = (t: number, width: number, height: number) => {
    const size = {
      width,
      height,
      // 割れはじめにすっと隙間が開く
      gap: GAP * width * easeOutCubic(clamp(t * 4, 0, 1)),
      // 3回振れながら小さくなる揺れ
      swing: Math.sin(3 * Math.PI * t) * (1 - t),
    };
    const maxDelay = Math.max(...CURTAINS.map(({ delay }) => delay));

    curtains.forEach((paths, index) => {
      const { delay } = CURTAINS[index];
      const q = easeInOutSine(clamp((t - delay) / (1 - maxDelay), 0, 1));
      drawCurtain(paths, index, q, size);
    });
  };

  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (opening && svg && backdrop && wall && logo && !reducedMotion.matches) {
    /*
     * ページの一番上から見せる。再読み込みや戻るでブラウザが前のスクロール位置に戻さないよう、復元を止めてから動かす。
     * 流れている間はページのスクロールを止める（のれんの隙間から見えるページが動かないように）
     */
    history.scrollRestoration = "manual";
    window.scrollTo(0, 0);
    document.documentElement.style.overflow = "hidden";
    /*
     * 流れている間と終わった後を html の data-opening で知らせる。KV（KeyVisualPartsSection.astro）は、
     * 流れている間はパーツを隠し、終わったらフェードインさせる
     */
    document.documentElement.dataset.opening = "playing";
    const finish = () => {
      document.documentElement.style.removeProperty("overflow");
      document.documentElement.dataset.opening = "done";
    };
    // 途中で止まっても、CSS で覆いを消すのと同じ 6 秒後にはスクロールでき、KV も表示されるようにする
    setTimeout(finish, 6000);
    const start = performance.now();
    // 画面の大きさが変わったときだけ座標を合わせ直す。毎フレーム設定すると SVG 全体を計算し直すため
    let lastWidth = 0;
    let lastHeight = 0;

    const tick = (now: number) => {
      const elapsed = now - start;
      // 座標を画面のピクセルに合わせる。丸まりが縦横で歪まないように
      const width = window.innerWidth;
      const height = window.innerHeight;
      const resized = width !== lastWidth || height !== lastHeight;
      if (resized) {
        svg.setAttribute("viewBox", `0 0 ${width} ${height}`);
        lastWidth = width;
        lastHeight = height;
      }

      if (elapsed < NOREN_START) {
        // 1. 壁が下から伸びる。伸びきったら画面を覆ったまま止めておく
        const p = easeOutCubic(clamp(elapsed / DURATION_RISE, 0, 1));
        if (resized) {
          for (const rect of [backdrop, wall]) {
            rect.setAttribute("width", `${width}`);
            rect.setAttribute("height", `${height}`);
          }
        }
        wall.setAttribute("y", `${height * (1 - p)}`);

        // 2. 壁が伸びきったら、ロゴマークをフェードインさせ、少し止めてからフェードアウトさせる
        const logoElapsed = elapsed - DURATION_RISE;
        const opacity =
          logoElapsed < DURATION_LOGO_IN
            ? logoElapsed / DURATION_LOGO_IN
            : 1 -
              (logoElapsed - DURATION_LOGO_IN - DURATION_LOGO_HOLD) /
                DURATION_LOGO_OUT;
        logo.style.opacity = `${clamp(opacity, 0, 1)}`;
      } else if (elapsed < NOREN_START + DURATION_NOREN) {
        // 3. 黒い地と1枚の壁を、割れたのれんに替える。のれんの隙間からページが見える
        if (wall.isConnected) {
          backdrop.remove();
          wall.remove();
          logo.remove();
        }
        drawCurtains((elapsed - NOREN_START) / DURATION_NOREN, width, height);
      } else {
        opening.remove();
        finish();
        return;
      }
      requestAnimationFrame(tick);
    };

    requestAnimationFrame(tick);
  } else {
    opening?.remove();
  }
</script>
