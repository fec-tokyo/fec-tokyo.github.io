---
import { Image } from "astro:assets";
import ArrowRightIcon from "@/assets/icon/icon-arrow-right.svg";
import type { GuestSpeaker } from "@/data/2026/guestSpeakers";

/*
 * ゲストスピーカーのカード。上に正方形の写真、下に名前と所属を置く。
 * - speakers を渡さないときは、まだ公開していない枠として「coming soon...」と公開予定日を出す
 * - ふたりで登壇するセッションは、カードをひとつにして写真を横に並べる（Figma の duo）。
 *   名前と所属はまとめて 1 行ずつ出す
 * - url（セッションの詳細ページ）を渡したときは、カード全体をリンクにして、ホバーでカードを黒くする。
 *   詳細ページがまだないスピーカーはリンクにせず、矢印も出さない
 * - 写真がまだないスピーカーは、写真の位置にグレーの面を出す
 */
type Props =
  | {
      speakers: GuestSpeaker[];
      url?: string;
    }
  | {
      speakers?: undefined;
      publishDateText: string;
    };

const props = Astro.props;
const speakers = props.speakers;
const url = "url" in props ? props.url : undefined;
const Tag = url ? "a" : "div";
const isDuo = speakers !== undefined && speakers.length > 1;
const name = speakers?.map((speaker) => speaker.name).join(" & ");
// 同じ会社のふたりなら所属は 1 回だけ出す
const company = [
  ...new Set(speakers?.flatMap(({ company }) => company ?? [])),
].join(" / ");
---

{
  speakers ? (
    <Tag class:list={["card", { link: url }]} href={url}>
      <div class:list={["photoFrame", { duo: isDuo }]}>
        {speakers.map((speaker) => (
          <div class:list={["photoCell", { noPhoto: !speaker.image }]}>
            {speaker.image && (
              <Image src={speaker.image} alt="" width={480} class="photo" />
            )}
          </div>
        ))}
      </div>
      <div class="info">
        <div class="texts">
          <p class="name">{name}</p>
          {company && <p class="company">{company}</p>}
        </div>
        {url && (
          <span class="arrow" aria-hidden="true">
            <ArrowRightIcon />
          </span>
        )}
      </div>
    </Tag>
  ) : (
    <div class="card">
      <div class="photoFrame empty">
        <p class="comingSoon">coming soon...</p>
      </div>
      <div class="info empty">
        <p class="publishDate">
          {"publishDateText" in props && props.publishDateText}
        </p>
      </div>
    </div>
  )
}

<style scoped>
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    /* ふたり用のカードで、写真の高さを 1 列分のカードにそろえるために使う */
    container-type: inline-size;
    overflow: hidden;
    color: var(--color-black);
    text-decoration: none;
    background-color: var(--color-white);
    border-radius: 16px;
    transition:
      color 200ms ease,
      background-color 200ms ease;
  }

  .photoFrame {
    display: flex;
    overflow: hidden;
    /* 透過のある写真（PNG）でもセクションの背景が透けないように、白を敷いておく */
    background-color: var(--color-white);
    border: 2px solid var(--color-white);
    border-radius: 16px 16px 0 0;
    transition: border-color 200ms ease;
  }

  .photoCell {
    position: relative;
    flex: 1;
    min-width: 0;
    aspect-ratio: 1;
    overflow: hidden;
  }

  .photoCell.noPhoto {
    background-color: var(--color-gray);
  }

  .photo {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale 400ms var(--easing-out);
  }

  /*
   * ふたり用のカードは 2 列分の幅になる。写真を正方形のままにすると隣のカードより背が高くなるので、
   * 写真の高さは 1 列分のカードの写真（カードの幅から列の間の 20px を引いた半分）にそろえ、写真は切り抜いて出す
   */
  .photoFrame.duo {
    flex-grow: 1;
    min-height: calc(50cqi - 10px);
  }

  .photoFrame.duo .photoCell {
    aspect-ratio: auto;
  }

  .info {
    display: flex;
    flex-grow: 1;
    gap: 8px;
    align-items: center;
    padding: 12px;
  }

  .photoFrame.duo + .info {
    flex-grow: 0;
  }

  .texts {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
    padding-bottom: 8px;
    font-family: "Noto Sans JP", sans-serif;
    overflow-wrap: anywhere;
  }

  .name {
    margin: 0;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.2;
  }

  .company {
    margin: 0;
    font-size: 12px;
    font-weight: 400;
    line-height: 1;
  }

  .arrow {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    color: var(--color-white);
    background-color: var(--color-black);
    border: 1px solid transparent;
    border-radius: 9999px;
    transition: border-color 200ms ease;
  }

  .arrow :global(svg) {
    display: block;
  }

  @media (hover: hover) {
    .link:hover {
      color: var(--color-white);
      background-color: var(--color-black);
    }

    .link:hover .photoFrame {
      border-color: var(--color-black);
    }

    /* 写真は枠（overflow: hidden）の中で拡大するので、カードの大きさは変わらない */
    .link:hover .photo {
      scale: 1.2;
    }

    .link:hover .arrow {
      border-color: var(--color-white);
    }
  }

  .link:focus-visible {
    outline: 2px solid var(--color-off-white);
    outline-offset: 4px;
  }

  /* まだ公開していない枠 */
  .photoFrame.empty {
    align-items: center;
    justify-content: center;
    aspect-ratio: 1;
    background-color: var(--color-gray);
  }

  .comingSoon {
    margin: 0;
    font-family: Montserrat, sans-serif;
    font-size: 24px;
    font-weight: 900;
    line-height: 1.2;
    color: var(--color-light-gray);
    text-align: center;
    text-transform: uppercase;
  }

  .info.empty {
    min-height: 66px;
    padding: 12px 12px 16px;
  }

  .publishDate {
    margin: 0;
    font-family: "Noto Sans JP", sans-serif;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-gray);
  }

  /*
   * タブレット以下: カードの幅が狭くなるので、名前と所属の下に横幅いっぱいの矢印のボタンを置く（Figma の SP 用のカード）。
   * 矢印は帯の下端に寄せて、同じ段のカードで位置をそろえる
   */
  @media (width <= 1080px) {
    .info:not(.empty) {
      flex-direction: column;
      gap: 12px;
      align-items: stretch;
      padding: 10px;
    }

    .texts {
      flex: none;
      padding-bottom: 0;
    }

    .company {
      line-height: 1.2;
    }

    .arrow {
      width: auto;
      height: auto;
      /* Figma の上下の余白は 2px。ホバー用の透明な枠線（1px）の分を差し引いている */
      padding-block: 1px;
      margin-top: auto;
    }

    .comingSoon {
      font-size: 18px;
    }

    .publishDate {
      font-size: 14px;
    }
  }

  /* モバイル: 2 列なので、ふたり用のカードは 1 段まるごと使う。写真は正方形のまま並べる */
  @media (width <= 720px) {
    .photoFrame.duo {
      flex-grow: 0;
      min-height: 0;
    }

    .photoFrame.duo .photoCell {
      aspect-ratio: 1;
    }
  }
</style>
