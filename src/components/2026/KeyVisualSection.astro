---
import CraneImage from "@/assets/2026/keyvisual-crane.png";
import KeyVisualMobileImage from "@/assets/2026/keyvisual-mobile2.png";
import KeyVisualTabletImage from "@/assets/2026/keyvisual-tablet.png";
import KeyVisualImage from "@/assets/2026/keyvisual.png";
import ScrollIndicator from "@/components/2026/ScrollIndicator.astro";
import type { ImageMetadata } from "astro";
import { Image, getImage } from "astro:assets";

const optimize = (src: ImageMetadata) =>
  getImage({ src, format: "webp", layout: "constrained", width: src.width });

const desktop = await optimize(KeyVisualImage);
const tablet = await optimize(KeyVisualTabletImage);
const mobile = await optimize(KeyVisualMobileImage);
---

<section id="kv" class="container">
  <div class="visual">
    <picture class="keyVisualPicture">
      <source
        media="(width <= 720px)"
        srcset={mobile.srcSet.attribute}
        sizes={mobile.attributes.sizes}
        width={mobile.attributes.width}
        height={mobile.attributes.height}
      />
      <source
        media="(width <= 1080px)"
        srcset={tablet.srcSet.attribute}
        sizes={tablet.attributes.sizes}
        width={tablet.attributes.width}
        height={tablet.attributes.height}
      />
      <img
        src={desktop.src}
        srcset={desktop.srcSet.attribute}
        sizes={desktop.attributes.sizes}
        width={desktop.attributes.width}
        height={desktop.attributes.height}
        alt="フロントエンドカンファレンス東京2026 ”大師走祭” 開催日 2026年12月05日 会場 ABEMA TOWERS"
        class="keyVisual"
        fetchpriority="high"
      />
    </picture>
    <Image src={CraneImage} alt="" class="crane" />
    <div class="scroll">
      <ScrollIndicator />
    </div>
  </div>
</section>

<style scoped>
  /*
   * KV は「画面の左右端から 120px（タブレット以下は 20px）」「ヘッダーの下端から 10px」「KV とスクロール誘導の間 16px」「スクロール誘導の下端からセクションの下端まで 16px」の
   * 枠に収まる範囲で、縦横比を保ったまま最大まで広げる。
   * セクションは画面の高さ以上にして、開いた時点で次のセクション（Message）が画面に入らないようにする。
   * 枠より画面が縦長のときは、KV とスクロール誘導をまとめて上下の中央に置く。
   */
  .container {
    /*
     * 上の余白（ヘッダーの分）、左右の余白、下の余白、KV とスクロール誘導の間、スクロール誘導の高さ、KV 画像の縦横比。
     * KV とスクロール誘導の間、スクロール誘導の下は全端末 16px
     */
    --kv-top: 70px;
    --kv-side: 120px;
    --kv-bottom: 16px;
    --kv-scroll-gap: 16px;
    --kv-scroll-height: 63px;
    --kv-aspect-ratio: calc(2208 / 1200);

    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 100svh;

    /*
     * 鶴は KV の右にはみ出す。ここで切ると画面の端より手前で羽が切れるので、
     * 横スクロールが出ないようにする切り取りは画面幅の main（foundation.css）に任せている。
     */
    padding: var(--kv-top) var(--kv-side) var(--kv-bottom);
  }

  /*
   * 1行目に KV、2行目にスクロール誘導を置き、鶴は KV に重ねる。
   * 鶴が KV の下にはみ出した分で高さが増えると、スクロール誘導が画面の下端からの余白を越えてしまうので、
   * 鶴は absolute にして高さに含めない。
   */
  .visual {
    position: relative;
    display: grid;
    grid-template-rows: auto auto;
    grid-template-columns: minmax(0, 1fr);
    width: min(
      100%,
      (
          100svh - var(--kv-top) - var(--kv-bottom) - var(--kv-scroll-gap) -
            var(--kv-scroll-height)
        ) *
        var(--kv-aspect-ratio)
    );
    margin-inline: auto;
  }

  .keyVisualPicture {
    grid-area: 1 / 1;
  }

  /* KV の下に中央揃え */
  .scroll {
    grid-area: 2 / 1;
    justify-self: center;
    margin-top: var(--kv-scroll-gap);
  }

  .keyVisual {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 2px 8px rgb(0 0 0 / 30%));
  }

  /*
   * KV 画像を基準に配置する。
   * Figma（KV: 1360×739）での位置 left 860px / top 415px / 幅 560px を KV の幅に対する割合にしている。
   * margin の % は上下も含めて幅基準なので、top も 1360 で割る。
   * KV の右端からはみ出すのはデザイン通り。
   */
  .crane {
    position: absolute;
    top: 0;
    left: 0;
    width: calc(560 / 1360 * 100%);
    height: auto;
    margin-top: calc(415 / 1360 * 100%);
    margin-left: calc(860 / 1360 * 100%);
    /* Figma の影（10px -2px 12px）に見た目を合わせるため、ぼかしは Figma の値の半分にしている */
    filter: drop-shadow(10px -2px 6px rgb(16 16 16 / 24%));
  }

  /* タブレット: 鶴はタブレット用の KV に描き込まれているので重ねない。スクロール誘導は縮めているので高さ 56px */
  @media (width <= 1080px) {
    .container {
      --kv-side: 20px;
      --kv-scroll-height: 56px;
      --kv-aspect-ratio: calc(1032 / 1299);
    }

    .crane {
      display: none;
    }
  }

  /*
   * ヘッダーが2段になる幅（Header.astro と同じ 780px）では、KV をヘッダーの 10px 下から始める。
   * タブレットのロゴ（高さ 40px）のままだとヘッダーは 98px なので 108px
   */
  @media (width <= 780px) {
    .container {
      --kv-top: 108px;
    }
  }

  /* モバイル: ロゴが高さ 32px になりヘッダーは 92px なので、Figma 通り top 102px */
  @media (width <= 720px) {
    .container {
      --kv-top: 102px;
      --kv-aspect-ratio: calc(720 / 1192);
    }
  }
</style>
