/*
 * パーツをどこを基準に置くか。
 * - x: stage はデザインの枠（画面の中央に置いた、デザインの幅 × --unit の枠）から、left / right は画面の左右端から
 * - y: top は画面の上端から、stage は枠の上端から（画面がデザインより縦長のときは余った分だけ下げて下端にそろえる）、
 *   bottom は画面の下端から
 * - fluid: 大きさも位置も画面幅に比例させる（雲）
 */
const anchors: Record<
  PartName,
  { x: "stage" | "left" | "right"; y: "top" | "stage" | "bottom"; fluid?: true }
> = {
  backgroundLogo: { x: "stage", y: "stage" },
  lanternLeft: { x: "left", y: "top" },
  lanternRight: { x: "right", y: "top" },
  cloudLeft: { x: "left", y: "bottom", fluid: true },
  cloudRight: { x: "right", y: "bottom", fluid: true },
  sun: { x: "stage", y: "stage" },
  daruma: { x: "stage", y: "stage" },
  scroll: { x: "stage", y: "bottom" },
  craneALeft: { x: "stage", y: "stage" },
  craneBLeft: { x: "stage", y: "stage" },
  craneCLeft: { x: "stage", y: "stage" },
  craneDLeft: { x: "stage", y: "stage" },
  craneARight: { x: "stage", y: "stage" },
  craneBRight: { x: "stage", y: "stage" },
  craneCRight: { x: "stage", y: "stage" },
  craneDRight: { x: "stage", y: "stage" },
  mist1: { x: "stage", y: "top" },
  mist2: { x: "right", y: "top" },
  mist3: { x: "left", y: "top" },
  mist3Flip: { x: "right", y: "top" },
  mist4: { x: "stage", y: "top" },
};

const round = (value: number, digits = 2) => Number(value.toFixed(digits));
// スクロール誘導の高さの下限（px）
const SCROLL_MIN_HEIGHT = 40;
/*
 * 提灯・鶴に付ける影。ずれとぼかしはほかの寸法と同じく --unit 倍する。
 * filter は回転・反転の前にかかるので、回転・反転したパーツは、画面上で同じ向きに落ちるようずれを逆に回しておく
 */
const SHADOW = { x: 10, y: -2, blur: 6, color: "rgb(16 16 16 / 24%)" };
const shadowParts: PartName[] = [
  "lanternLeft",
  "lanternRight",
  "craneALeft",
  "craneBLeft",
  "craneCLeft",
  "craneDLeft",
  "craneARight",
  "craneBRight",
  "craneCRight",
  "craneDRight",
];
const mediaOf = (frame: Frame) =>
  frame.minAspectRatio ? `(min-aspect-ratio: ${frame.minAspectRatio})` : "";

// 1つのデザインでの、パーツの位置・大きさ・回転のスタイル
const placementStyle = (frame: Frame, placement: Placement, zIndex: number) => {
  const anchor = anchors[placement.part];
  const unit = anchor.fluid ? "var(--unit-fluid)" : "var(--unit)";
  // 回転した後の枠の中心に、回転する前の要素の中心を合わせる
  const left = placement.x + placement.boxWidth / 2 - placement.width / 2;
  const top = placement.y + placement.boxHeight / 2 - placement.height / 2;
  const right = frame.width - left - placement.width;
  const bottom = frame.height - top - placement.height;
  const styles = ["display: block", `z-index: ${zIndex}`];

  if (placement.part === "scroll") {
    /*
     * スクロール誘導もほかのパーツと同じく、Figma の大きさを --unit 倍する（ScrollIndicator の寸法の 1px を、
     * Figma での倍率 × --unit にする。16:9 の幅 99.88px が等倍）。位置は中央と下端からの距離で置く。
     * スマホでは小さくなりすぎるので、高さ（等倍で 63px）は SCROLL_MIN_HEIGHT より小さくしない
     */
    styles.push(
      `--scroll-indicator-unit: max(${SCROLL_MIN_HEIGHT} / 63 * 1px, ${round(placement.boxWidth / 99.88, 4)} * var(--unit))`,
      "--scroll-indicator-zoom: 1",
      `left: calc(var(--stage-left) + ${round(placement.x + placement.boxWidth / 2)} * var(--unit))`,
      `bottom: max(var(--scroll-min-bottom), ${round(frame.height - placement.y - placement.boxHeight)} * var(--unit))`,
    );
    return styles.join("; ");
  }

  styles.push(`width: calc(${round(placement.width)} * ${unit})`);
  if (anchor.x === "stage") {
    styles.push(`left: calc(var(--stage-left) + ${round(left)} * ${unit})`);
  } else if (anchor.x === "left") {
    styles.push(`left: calc(${round(left)} * ${unit})`);
  } else {
    styles.push(`right: calc(${round(right)} * ${unit})`);
  }
  if (anchor.y === "top") {
    styles.push(`top: calc(${round(top)} * ${unit})`);
  } else if (anchor.y === "stage") {
    styles.push(`top: calc(${round(top)} * ${unit} + var(--extra))`);
  } else {
    styles.push(`bottom: calc(${round(bottom)} * ${unit})`);
  }
  const transforms = [
    placement.rotate ? `rotate(${placement.rotate}deg)` : "",
    placement.flip ? "scaleY(-1)" : "",
  ].filter(Boolean);
  if (transforms.length > 0) styles.push(`transform: ${transforms.join(" ")}`);
  if (shadowParts.includes(placement.part)) {
    const radian = ((placement.rotate ?? 0) * Math.PI) / 180;
    const x = SHADOW.x * Math.cos(radian) + SHADOW.y * Math.sin(radian);
    const y = -SHADOW.x * Math.sin(radian) + SHADOW.y * Math.cos(radian);
    styles.push(
      `filter: drop-shadow(calc(${round(x)} * ${unit}) calc(${round(placement.flip ? -y : y)} * ${unit}) calc(${SHADOW.blur} * ${unit}) ${SHADOW.color})`,
    );
  }
  return styles.join("; ");
};

/*
 * 縦横比ごとのスタイル。一番縦長のデザインを基本にして、横長のデザインほど後ろに書いて上書きする。
 * どのデザインにも全パーツの表示・非表示を書くので、前のデザインのパーツが残ることはない。
 */
const allParts = Object.keys(anchors) as PartName[];
const frameStyles = [...frames]
  .reverse()
  .map((frame) => {
    const rules = [
      `#kv { --frame-width: ${frame.width}; --frame-height: ${frame.height}; }`,
      ...allParts.map((part) => {
        const index = frame.parts.findIndex((p) => p.part === part);
        const style =
          index === -1
            ? "display: none"
            : placementStyle(frame, frame.parts[index], index);
        return `#kv [data-part="${part}"] { ${style}; }`;
      }),
    ].join("\n");
    const media = mediaOf(frame);
    return media ? `@media ${media} {\n${rules}\n}` : rules;
  })
  .join("\n");

/*
 * 画像はデザインごとの表示幅（Figma の幅 × --unit）に足りる大きさを選ばせる。
 * Figma の幅の 0.5〜3 倍（画面の高さ 1440px の高解像度の画面で約 2.67 倍）の幅で作り、元画像より大きい幅は作らない。
 * sizes は縦横比ごとに、そのデザインでの表示幅を CSS と同じ式で書く。
 */
const sizesFor = (parts: PartName[], targetFrames: Frame[]) =>
  targetFrames
    .map((frame, index) => {
      const placement = frame.parts.find((p) => parts.includes(p.part));
      const width = placement?.width ?? 0;
      const size = `min(${round((width / frame.height) * 100)}vh, ${round((width / frame.width) * 100)}vw)`;
      const media = mediaOf(frame);
      return index === targetFrames.length - 1 || !media
        ? size
        : `${media} ${size}`;
    })
    .join(", ");

const optimize = async (
  src: ImageMetadata,
  parts: PartName[],
  targetFrames: Frame[],
) => {
  const maxWidth = Math.max(
    ...targetFrames.flatMap((frame) =>
      frame.parts.filter((p) => parts.includes(p.part)).map((p) => p.width),
    ),
  );
  const widths = [
    ...new Set(
      [0.5, 0.75, 1, 1.5, 2, 3].map((scale) =>
        Math.min(Math.round(maxWidth * scale), src.width),
      ),
    ),
  ];
  // src（srcset に対応していないブラウザ向け）も元画像の大きさではなく、srcset の一番大きい幅にする
  const image = await getImage({
    src,
    widths,
    width: Math.max(...widths),
    format: "webp",
    quality: 80,
  });
  return {
    src: image.src,
    srcset: image.srcSet.attribute,
    sizes: sizesFor(parts, targetFrames),
  };
};

/*
 * 縦長のデザインは、太陽をタブレット以下用の画像に替える（3:4・9:16・9:20）。
 * 提灯を縦長の画像に替えるのは 9:16 と 9:20 だけで、3:4 は横長のデザインと同じ画像を使う
 */
const splitFrames = (firstTallName: string) => {
  const index = frames.findIndex((frame) => frame.name === firstTallName);
  return {
    wide: frames.slice(0, index),
    tall: frames.slice(index),
    // tall のデザインを使う画面（max-aspect-ratio だと、ちょうど境目の比率の画面で 1つ前のデザインと重なってしまう）
    media: `not all and (min-aspect-ratio: ${frames[index - 1].minAspectRatio})`,
  };
};
const sunFrames = splitFrames("3:4");
const lanternFrames = splitFrames("9:16");

const sun = await optimize(Sun, ["sun"], sunFrames.wide);
const sunTablet = await optimize(SunTablet, ["sun"], sunFrames.tall);
const lanterns = await Promise.all(
  (
    [
      ["lanternLeft", LanternLeft, LanternSmallLeft],
      ["lanternRight", LanternRight, LanternSmallRight],
    ] as const
  ).map(async ([part, wide, tall]) => ({
    part,
    wide: await optimize(wide, [part], lanternFrames.wide),
    tall: await optimize(tall, [part], lanternFrames.tall),
  })),
);
const daruma = await optimize(Daruma, ["daruma"], frames);
const cranes = await Promise.all(
  (
    [
      ["craneA", CraneA],
      ["craneB", CraneB],
      ["craneC", CraneC],
      ["craneD", CraneD],
    ] as const
  ).flatMap(([name, src]) =>
    (["Left", "Right"] as const).map(async (side) => {
      const part = `${name}${side}` as PartName;
      return { part, ...(await optimize(src, [part], frames)) };
    }),
  ),
);
const mists: { part: PartName; src: string }[] = [
  { part: "mist1", src: Mist1.src },
  { part: "mist2", src: Mist2.src },
  { part: "mist3", src: Mist3.src },
  { part: "mist3Flip", src: Mist3.src },
  { part: "mist4", src: Mist4.src },
];
---

<section id="kv" class="container">
  <Fragment set:html={`<style>${frameStyles}</style>`} />
  <img
    src={BackgroundLogo.src}
    alt=""
    class="part"
    data-part="backgroundLogo"
  />
  {
    lanterns.map(({ part, wide, tall }) => (
      <picture>
        <source
          media={lanternFrames.media}
          srcset={tall.srcset}
          sizes={tall.sizes}
        />
        <img
          src={wide.src}
          srcset={wide.srcset}
          sizes={wide.sizes}
          alt=""
          class="part"
          data-part={part}
        />
      </picture>
    ))
  }
  <img src={Cloud.src} alt="" class="part" data-part="cloudLeft" />
  <img src={Cloud.src} alt="" class="part" data-part="cloudRight" />
  {
    cranes.map((crane) => (
      <img
        src={crane.src}
        srcset={crane.srcset}
        sizes={crane.sizes}
        alt=""
        class="part"
        data-part={crane.part}
      />
    ))
  }
  <picture>
    <source
      media={sunFrames.media}
      srcset={sunTablet.srcset}
      sizes={sunTablet.sizes}
    />
    <img
      src={sun.src}
      srcset={sun.srcset}
      sizes={sun.sizes}
      alt="フロントエンドカンファレンス東京 二〇二六 大師走祭 12.05 ABEMA TOWERS"
      class="part"
      data-part="sun"
      fetchpriority="high"
    />
  </picture>
  <img
    src={daruma.src}
    srcset={daruma.srcset}
    sizes={daruma.sizes}
    alt=""
    class="part"
    data-part="daruma"
  />
  <div class="part" data-part="scroll">
    <ScrollIndicator />
  </div>
  {
    mists.map((mist) => (
      <img src={mist.src} alt="" class="part" data-part={mist.part} />
    ))
  }
</section>

<style scoped>
  /*
   * 各パーツの位置と大きさは、選んだデザインの値を --unit 倍したもの（スタイルは frameStyles で作っている）。
   * --unit はデザインの高さで画面の高さになる比率で、デザインより縦長の画面では、デザインの幅で画面の幅になる比率で止める。
   * パーツはデザインの枠（幅 --frame-width × --unit、--stage-left が左端）を画面の中央に置いて、それを基準にする。
   * 提灯・雲と、端にかかる霞は画面の左右端を基準にするので、デザインより横長の画面では枠の外側に広がる。
   * 雲は大きさも画面幅に比例させる（--unit-fluid はデザインの幅で画面の幅になる比率）。
   * デザインより縦長の画面では、提灯・霞は上端に残し、ほかのパーツは余った分（--extra）だけ下げて下端にそろえる。
   * --unit などは子孫で計算されるので、cqw はこのセクションの幅になる。
   */
  .container {
    --unit: min(100svh / var(--frame-height), 100cqw / var(--frame-width));
    --unit-fluid: calc(100cqw / var(--frame-width));
    --stage-left: calc(50% - var(--frame-width) / 2 * var(--unit));
    --extra: max(0px, 100svh - var(--frame-height) * var(--unit));

    /* スクロールしても画面上部に残し、次のセクションがその上に重なる（index.astro で親の div に入れている） */
    position: sticky;
    top: 0;
    height: 100svh;
    container-type: inline-size;
    overflow: hidden;

    /* Figma の塗り: 上から 20% まで藍色、下端でクリーム色になるグラデーションに、白いノイズを重ねる */
    background-color: #00555f;
    background-image:
      var(--texture-noise-subtle),
      linear-gradient(180deg, #00555f 20%, var(--color-cream) 100%);
    background-size: var(--texture-noise-subtle-size), auto;
  }

  /* 表示するかどうかと位置・大きさは、縦横比ごとのスタイル（frameStyles）で決める */
  .part {
    position: absolute;
    display: none;
    max-width: none;
    height: auto;
    pointer-events: none;
  }

  /* 背景のロゴ（SVG 側で白の 10%）は、下の色とオーバーレイで合成する */
  [data-part="backgroundLogo"] {
    mix-blend-mode: overlay;
  }

  /*
   * スクロール誘導の下端から画面の下端までの距離の下限（--scroll-min-bottom）。KV の下端には MessageSection の雲が重なるので、
   * 画面が小さく KV が縮んでも雲にかからないよう、雲の高さ（MessageSection の --cloud-height）に 8px のすき間を足した分より下げない
   */
  [data-part="scroll"] {
    --scroll-min-bottom: calc(50px + 8px);

    translate: -50% 0;
  }

  /* 縦長の画面（縦横比 9:16 以下）では、MessageSection の雲が高さ 20px になる */
  @media (aspect-ratio <= 9 / 16) {
    [data-part="scroll"] {
      --scroll-min-bottom: calc(20px + 8px);
    }
  }

  /*
   * オープニング（OpeningAnimation.astro）が流れている間は、雲・鶴・提灯・太陽・だるま・スクロール誘導を隠しておき、
   * のれんが上がりきる 500ms 前（OpeningAnimation.astro の KV_REVEAL_LEAD）からこの順に、10px 下から上がりながらフェードインさせる。
   * 前のパーツが出はじめてから 200ms ずつずらして続けて出す。
   * オープニングを流さないとき（動きを減らす設定など）は data-opening が付かないので、最初から表示する
   */
  .container {
    --reveal-duration: 600ms;
    --reveal-stagger: 200ms;
  }

  [data-part^="cloud"] {
    --reveal-order: 0;
  }

  [data-part^="crane"] {
    --reveal-order: 1;
  }

  [data-part^="lantern"] {
    --reveal-order: 2;
  }

  [data-part="sun"] {
    --reveal-order: 3;
  }

  [data-part="daruma"] {
    --reveal-order: 4;
  }

  [data-part="scroll"] {
    --reveal-order: 5;
  }

  :global(:root[data-opening="playing"])
    .part:is(
      [data-part^="cloud"],
      [data-part^="crane"],
      [data-part^="lantern"],
      [data-part="sun"],
      [data-part="daruma"],
      [data-part="scroll"]
    ) {
    opacity: 0;
  }

  :global(:root[data-opening="done"])
    .part:is(
      [data-part^="cloud"],
      [data-part^="crane"],
      [data-part^="lantern"],
      [data-part="sun"],
      [data-part="daruma"],
      [data-part="scroll"]
    ) {
    animation: kv-reveal var(--reveal-duration) ease-out
      calc(var(--reveal-order) * var(--reveal-stagger)) both;
  }

  /* 回転・反転は transform で付けているので、ずらすのは translate で行う */
  @keyframes kv-reveal {
    from {
      opacity: 0;
      translate: 0 10px;
    }
  }

  /* スクロール誘導は中央寄せに translate: -50% 0 を使っているので、それを保ったまま 10px 下から上げる */
  :global(:root[data-opening="done"]) .part[data-part="scroll"] {
    animation-name: kv-reveal-scroll;
  }

  @keyframes kv-reveal-scroll {
    from {
      opacity: 0;
      translate: -50% 10px;
    }
  }
</style>
