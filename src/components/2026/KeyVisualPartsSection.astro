  | "craneCLeft"
  | "craneDLeft"
  | "craneARight"
  | "craneBRight"
  | "craneCRight"
  | "craneDRight"
  | "mist1"
  | "mist2"
  | "mist3"
  | "mist3Flip"
  | "mist4";

/*
 * Figma での配置。x / y / boxWidth / boxHeight は回転した後に占める枠、width / height は回転する前の大きさ。
 * rotate と flip は Figma の回転と上下反転（左右反転は 180° 回転 + 上下反転で表している）。
 * parts の並びは重なり順（後ろが手前）。16:9・3:2・4:3 は、鶴が太陽に重ならないよう Figma と違って鶴を太陽より奥にしている。
 */
type Placement = {
  part: PartName;
  x: number;
  y: number;
  boxWidth: number;
  boxHeight: number;
  width: number;
  height: number;
  rotate?: number;
  flip?: boolean;
};

type Frame = {
  name: string;
  width: number;
  height: number;
  /*
   * この縦横比（幅 / 高さ）以上の画面で使う。基本はデザインの縦横比と同じで、一番縦長のデザインには付けない。
   * デザインより少し小さい比率にしたときは、その比率までは幅に合わせて少しだけ縮める
   */
  minAspectRatio?: string;
  parts: Placement[];
};

