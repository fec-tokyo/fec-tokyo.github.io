---
import type { HTMLAttributes } from "astro/types";
import ArrowIcon from "@/assets/icon/icon-arrow.svg";

/*
 * 丸で囲んだ右上向きの矢印。別タブで開くリンク（ヘッダーの NEWS、リンクボタン）の右側に置く。
 * 枠線と矢印は文字色（currentColor）で描くので、置いた場所の文字色やホバーの色にそのまま合う。
 */
type Props = HTMLAttributes<"span">;

// 親から渡した class のスコープ用の属性も入るので、要素にそのまま展開する
const { class: className, ...rest } = Astro.props;
---

<span class:list={["circle", className]} aria-hidden="true" {...rest}>
  <ArrowIcon />
</span>

<style scoped>
  .circle {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border: 1px solid currentcolor;
    border-radius: 9999px;
    transition:
      color 200ms ease,
      background-color 200ms ease;
  }

  .circle :global(svg) {
    display: block;
  }
</style>
