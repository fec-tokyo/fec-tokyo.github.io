---
import type { HTMLAttributes } from "astro/types";
import ArrowIcon from "@/assets/icon/icon-arrow.svg";
import ArrowRightIcon from "@/assets/icon/icon-arrow-right.svg";

/*
 * 丸で囲んだ矢印。
 * - direction="upRight"（既定）: 右上向き。別タブで開くリンク（ヘッダーの NEWS、リンクボタン）の右側に置く
 * - direction="left": 左向き。前のページへ戻るボタンの左側に置く
 * 枠線と矢印は文字色（currentColor）で描くので、置いた場所の文字色やホバーの色にそのまま合う。
 */
type Props = HTMLAttributes<"span"> & {
  direction?: "upRight" | "left";
};

// 親から渡した class のスコープ用の属性も入るので、要素にそのまま展開する
const { class: className, direction = "upRight", ...rest } = Astro.props;
---

<span class:list={["circle", className]} aria-hidden="true" {...rest}>
  {
    direction === "left" ? (
      <ArrowRightIcon width={14} height={14} class="left" />
    ) : (
      <ArrowIcon />
    )
  }
</span>

<style scoped>
  .circle {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border: 1px solid currentcolor;
    border-radius: 9999px;
    transition:
      color 200ms ease,
      background-color 200ms ease;
  }

  .circle :global(svg) {
    display: block;
  }

  /* 右向きの矢印を裏返して左向きにする */
  .circle :global(.left) {
    rotate: 180deg;
  }
</style>
