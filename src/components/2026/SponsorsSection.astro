---
import { Image } from "astro:assets";
import SeigaihaImage from "@/assets/2026/seigaiha.svg";
import { SPONSORS } from "@/data/2026/sponsors";

const groups = [
  { key: "venue", title: "Venue Sponsor", sponsors: SPONSORS.venue },
  { key: "general", title: "General Sponsor", sponsors: SPONSORS.general },
] as const;
---

<section
  id="sponsors"
  class="container"
  aria-labelledby="sponsors-title"
  style={`--seigaiha-image: url(${SeigaihaImage.src})`}
>
  <div class="inner">
    <div class="heading">
      <hgroup class="titleGroup">
        <h2 id="sponsors-title" class="title">Sponsors</h2>
        <p class="subtitle">スポンサーのみなさま</p>
      </hgroup>
      <p class="note">※カナ読み五十音順です（法人格を除く）</p>
    </div>
    <div class="panel">
      {
        groups.map(({ key, title, sponsors }) => (
          <section class:list={["group", key]} aria-label={title}>
            <h3 class="groupTitle">{title}</h3>
            <ul class="list">
              {sponsors.map(({ name, url, image }) => (
                <li>
                  <a
                    href={url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="logo"
                  >
                    {image ? (
                      <Image src={image} alt={name} width={640} class="image" />
                    ) : (
                      <span class="name">{name}</span>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</section>

<style scoped>
  /*
   * 明るい面はページ側（index.astro の .page-bottom）で敷いている。
   * ロゴの面は右端を画面の端までつなげるので、1440px より広い画面ではその分（--bleed）だけ右にはみ出させる
   */
  .container {
    --bleed: max(0px, (100vw - var(--width-desktop)) / 2);

    overflow-x: clip;
  }

  .inner {
    display: flex;
    gap: 40px;
    align-items: flex-start;
    justify-content: space-between;
    max-width: var(--width-desktop);
    padding: 160px 0 0 120px;
    margin-inline: auto;
  }

  /* 見出しはスクロールしても残す。固定ヘッダーに重ならない位置で止める */
  .heading {
    position: sticky;
    top: 120px;
    display: flex;
    flex-shrink: 0;
    flex-direction: column;
    gap: 16px;
  }

  .titleGroup {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
    font-weight: 900;
    line-height: 1;
    text-transform: uppercase;
  }

  .title {
    margin: 0;
    font-family: Montserrat, sans-serif;
    font-size: 48px;
    font-weight: inherit;
  }

  .subtitle {
    margin: 0;
    font-family: "Noto Sans JP", sans-serif;
    font-size: 18px;
  }

  .note {
    margin: 0;
    font-family: "Noto Sans JP", sans-serif;
    font-size: 14px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.04em;
  }

  /* 塗りは MessageSection の面と同じく、地の色に白い青海波を 40% だけ透かして重ねる */
  .panel {
    --color-panel-base: #f6eedd;

    display: flex;
    flex: 0 1 calc(880px + var(--bleed));
    flex-direction: column;
    gap: 40px;
    min-width: 0;
    padding: 60px calc(80px + var(--bleed)) 80px 80px;
    margin-top: 60px;
    margin-right: calc(-1 * var(--bleed));
    background-color: var(--color-panel-base);
    background-image:
      linear-gradient(
        color-mix(in srgb, var(--color-panel-base) 60%, transparent),
        color-mix(in srgb, var(--color-panel-base) 60%, transparent)
      ),
      var(--seigaiha-image);
    border-radius: 40px 0 0 40px;
  }

  .group {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 720px;
  }

  .groupTitle {
    margin: 0;
    font-family: Montserrat, sans-serif;
    font-size: 24px;
    font-weight: 500;
    line-height: 1;
  }

  .list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .venue .list {
    grid-template-columns: 1fr;
  }

  /* ロゴの画像はそれぞれ上下の余白を含んでいるので、箱の高さいっぱいに収まる大きさで置く */
  .logo {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 679 / 381.9375;
    padding-inline: 60px;
    color: var(--color-black);
    text-decoration: none;
    background-color: var(--color-white);
  }

  .image {
    width: 100%;
    max-width: 560px;
    height: 100%;
    max-height: 315px;
    object-fit: contain;
  }

  .name {
    font-family: "Noto Sans JP", sans-serif;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.4;
    text-align: center;
    /* 長い社名を語の途中で折り返さない */
    word-break: auto-phrase;
  }

  /* タブレット: 見出しの下にロゴの面を置き、面は右端までつなげる */
  @media (width <= 1080px) {
    .inner {
      flex-direction: column;
      padding: 120px 0 0 40px;
    }

    .heading {
      position: static;
    }

    .panel {
      flex-basis: auto;
      align-self: stretch;
      margin-top: 0;
    }
  }

  /* モバイル: ロゴの箱を縦に積み、余白を詰める */
  @media (width <= 720px) {
    .inner {
      padding-left: 20px;
    }

    .panel {
      padding: 40px 20px 80px;
    }

    .list {
      grid-template-columns: 1fr;
    }
  }
</style>
